---
import { Gamepad2, Github, Mail, Share2, Star } from "lucide-astro";
import MusicPlayer from "./MusicPlayer.astro";

const isHome = Astro.url.pathname === "/";
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-wordmark" href="/" aria-label="RongYu's Notes 首页">
      <span class="site-wordmark__main">RongYu's Notes</span>
      <span class="site-wordmark__zh">容与</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <a href="/">首页</a>
      <a href="/latex/">讲义</a>
      <a href="/tools/">工具</a>
      <a href="/colophon/">跋页</a>
    </nav>

    <div class="site-actions">
      {isHome && (
        <a
          class="repository-star"
          href="https://github.com/RongYu221104/RongYu221104.github.io"
          target="_blank"
          rel="noreferrer"
          aria-label="在 GitHub 上 Star 本项目"
          title="在 GitHub 上 Star 本项目"
        >
          <Star size={16} strokeWidth={1.7} />
          <span class="repository-star__label">Star</span>
        </a>
      )}
      <a
        class="icon-link site-actions__secondary"
        href="https://github.com/RongYu221104"
        target="_blank"
        rel="noreferrer"
        aria-label="访问 GitHub"
        title="GitHub"
      >
        <Github size={18} strokeWidth={1.7} />
      </a>
      <a
        class="icon-link site-actions__secondary"
        href="mailto:rongyu221104@163.com"
        aria-label="发送邮件"
        title="邮箱"
      >
        <Mail size={18} strokeWidth={1.7} />
      </a>
      <a
        class="icon-link site-actions__secondary"
        href="https://steamcommunity.com/profiles/76561199701790707/"
        target="_blank"
        rel="noreferrer"
        aria-label="访问 Steam 个人主页"
        title="Steam"
      >
        <Gamepad2 size={18} strokeWidth={1.7} />
      </a>
      <button
        class="icon-link"
        type="button"
        data-site-share
        aria-label="分享当前页面"
        title="分享"
      >
        <Share2 size={18} strokeWidth={1.7} />
      </button>
      <MusicPlayer />
    </div>
  </div>
</header>

<script>
  function initializeSiteShare() {
    const button = document.querySelector<HTMLButtonElement>("[data-site-share]");
    if (!button || button.dataset.ready === "true") return;
    button.dataset.ready = "true";

    button.addEventListener("click", async () => {
      const share = {
        title: document.title,
        text: "容与的讲义与实用工具",
        url: window.location.href,
      };
      let shared = false;
      try {
        if (navigator.share) {
          await navigator.share(share);
          shared = true;
        } else {
          await navigator.clipboard.writeText(share.url);
          shared = true;
        }
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") return;
        try {
          await navigator.clipboard.writeText(share.url);
          shared = true;
        } catch {
          window.prompt("复制网页链接", share.url);
          shared = true;
        }
      }
      if (!shared) return;
      const originalLabel = button.getAttribute("aria-label") || "分享当前页面";
      button.classList.add("is-confirmed");
      button.setAttribute("aria-label", "分享链接已准备");
      window.setTimeout(() => {
        button.classList.remove("is-confirmed");
        button.setAttribute("aria-label", originalLabel);
      }, 1600);
    });
  }

  initializeSiteShare();
  document.addEventListener("astro:page-load", initializeSiteShare);
</script>
