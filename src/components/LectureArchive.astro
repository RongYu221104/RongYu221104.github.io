---
import { ChevronDown, Folder } from "lucide-astro";
import LectureRow from "./LectureRow.astro";
import {
  lectureKindLabels,
  lectures,
  type Lecture,
  type LectureKind,
  type LectureSubject,
} from "../data/lectures";

interface Props {
  subject: LectureSubject;
  titleZh: string;
  titleEn: string;
}

const { subject, titleZh, titleEn } = Astro.props;
const kinds: LectureKind[] = ["Stu", "Lec", "Rev", "Aux"];
const subjectLectures = lectures.filter((lecture) => lecture.subject === subject);

function arrangeByCourse(items: Lecture[]) {
  const direct = items.filter((lecture) => !lecture.course);
  const folders = new Map<string, Lecture[]>();
  items.forEach((lecture) => {
    if (!lecture.course) return;
    const folder = folders.get(lecture.course.code) ?? [];
    folder.push(lecture);
    folders.set(lecture.course.code, folder);
  });
  return { direct, folders: [...folders.entries()] };
}
---

<section class="archive-column" aria-labelledby={`${subject}-title`}>
  <header class="archive-column__header">
    <p class="archive-column__index">{subject === "maths" ? "Side A" : "Side B"}</p>
    <div>
      <h2 id={`${subject}-title`}>{titleZh}</h2>
      <p>{titleEn}</p>
    </div>
    <span>{subjectLectures.length} 份</span>
  </header>

  <div class="archive-column__body">
    {
      kinds.map((kind) => {
        const items = subjectLectures.filter((lecture) => lecture.kind === kind);
        const { direct, folders } = arrangeByCourse(items);
        return (
          <section class="lecture-group" aria-labelledby={`${subject}-${kind}`}>
            <header class="lecture-group__spine">
              <span>{kind}</span>
              <p id={`${subject}-${kind}`}>{lectureKindLabels[kind]}</p>
            </header>
            <div class="lecture-group__list">
              {direct.map((lecture) => <LectureRow lecture={lecture} />)}
              {folders.map(([courseCode, courseLectures]) => {
                const course = courseLectures[0].course!;
                return (
                  <details class="lecture-course-folder" data-lecture-course data-default-open="false">
                    <summary>
                      <span class="lecture-course-folder__icon" aria-hidden="true">
                        <Folder size={20} strokeWidth={1.6} />
                      </span>
                      <span class="lecture-course-folder__copy">
                        <strong>{courseCode} · {course.titleZh}</strong>
                        <small>{course.titleEn}</small>
                      </span>
                      <span class="lecture-course-folder__count">{courseLectures.length} 份</span>
                      <ChevronDown class="lecture-course-folder__chevron" size={18} strokeWidth={1.7} aria-hidden="true" />
                    </summary>
                    <div class="lecture-course-folder__contents">
                      {courseLectures.map((lecture) => <LectureRow lecture={lecture} />)}
                    </div>
                  </details>
                );
              })}
            </div>
          </section>
        );
      })
    }
  </div>
</section>
