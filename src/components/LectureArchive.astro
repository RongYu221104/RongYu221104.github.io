---
import { Download, FileText, Share2 } from "lucide-astro";
import {
  lectureCoverUrl,
  lectureKindLabels,
  lectureShareUrl,
  lectureUrl,
  lectureViewerUrl,
  lectures,
  type LectureKind,
  type LectureSubject,
} from "../data/lectures";

interface Props {
  subject: LectureSubject;
  titleZh: string;
  titleEn: string;
}

const { subject, titleZh, titleEn } = Astro.props;
const kinds: LectureKind[] = ["Stu", "Lec", "Rev", "Aux"];
const subjectLectures = lectures.filter((lecture) => lecture.subject === subject);
---

<section class="archive-column" aria-labelledby={`${subject}-title`}>
  <header class="archive-column__header">
    <p class="archive-column__index">{subject === "maths" ? "Side A" : "Side B"}</p>
    <div>
      <h2 id={`${subject}-title`}>{titleZh}</h2>
      <p>{titleEn}</p>
    </div>
    <span>{subjectLectures.length} 份</span>
  </header>

  <div class="archive-column__body">
    {
      kinds.map((kind) => {
        const items = subjectLectures.filter((lecture) => lecture.kind === kind);
        return (
          <section class="lecture-group" aria-labelledby={`${subject}-${kind}`}>
            <header class="lecture-group__spine">
              <span>{kind}</span>
              <p id={`${subject}-${kind}`}>{lectureKindLabels[kind]}</p>
            </header>
            <div class="lecture-group__list">
              {items.map((lecture) => {
                const url = lectureUrl(lecture);
                const viewerUrl = lectureViewerUrl(lecture);
                return (
                  <article
                    class="lecture-row"
                    data-lecture-card
                    data-preview-url={viewerUrl}
                    data-search-value={`${lecture.titleZh} ${lecture.titleEn} ${lectureKindLabels[lecture.kind]} ${lecture.kind} ${lecture.pages} 页 ${lecture.fileName}`.toLocaleLowerCase()}
                    tabindex="0"
                  >
                    <a
                      class="lecture-row__cover"
                      href={viewerUrl}
                      aria-label={`预览《${lecture.titleZh}》`}
                      tabindex="-1"
                    >
                      <img
                        src={lectureCoverUrl(lecture)}
                        width="720"
                        height="960"
                        loading="lazy"
                        alt={`《${lecture.titleZh}》讲义封面`}
                      />
                    </a>
                    <div class="lecture-row__copy">
                      <div class="lecture-row__title">
                        <h3>{lecture.titleZh}</h3>
                        <p>{lecture.titleEn}</p>
                      </div>
                      <div class="lecture-row__meta">
                        <span>{lecture.pages} 页</span>
                        <time datetime={lecture.updatedAt}>{lecture.updatedAt}</time>
                      </div>
                    </div>
                    <div class="lecture-row__actions">
                      <a
                        href={viewerUrl}
                        aria-label={`预览《${lecture.titleZh}》`}
                        title="预览"
                      >
                        <FileText size={18} strokeWidth={1.7} />
                      </a>
                      <button
                        type="button"
                        data-lecture-share
                        data-share-title={`${lecture.titleZh} | RongYu's Notes`}
                        data-share-text={`${lecture.titleZh} - ${lecture.titleEn}`}
                        data-share-url={lectureShareUrl(lecture)}
                        aria-label={`分享《${lecture.titleZh}》`}
                        title="分享"
                      >
                        <Share2 size={17} strokeWidth={1.7} />
                      </button>
                      <a
                        href={url}
                        download={lecture.fileName}
                        aria-label={`下载《${lecture.titleZh}》`}
                        title={`下载 ${lecture.fileName}`}
                      >
                        <Download size={18} strokeWidth={1.7} />
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })
    }
  </div>
</section>
