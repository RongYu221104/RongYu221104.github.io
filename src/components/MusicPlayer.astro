---
import {
  ArrowLeft,
  BookOpenText,
  ExternalLink,
  ListEnd,
  Menu,
  Music2,
  Pause,
  Play,
  Shuffle,
  SkipBack,
  SkipForward,
  X,
} from "lucide-astro";
import { tracks, type Track } from "../data/tracks";
import { MUSIC_CONTEXT_API_URL } from "../config/assets";

type CatalogAlbum = {
  album: string;
  cover: string;
  tracks: Array<Track & { index: number }>;
};

type CatalogArtist = {
  artist: string;
  albums: CatalogAlbum[];
};

const catalogGroups = tracks.reduce<CatalogArtist[]>((artists, track, index) => {
  let artist = artists.at(-1);
  if (!artist || artist.artist !== track.artist) {
    artist = { artist: track.artist, albums: [] };
    artists.push(artist);
  }

  let album = artist.albums.at(-1);
  if (!album || album.album !== track.album) {
    album = { album: track.album, cover: track.cover, tracks: [] };
    artist.albums.push(album);
  }

  album.tracks.push({ ...track, index });
  return artists;
}, []);
---

<div
  class="music-player"
  data-music-player
  data-tracks={JSON.stringify(tracks)}
  data-context-api={MUSIC_CONTEXT_API_URL}
  data-phase="idle"
  data-playback-mode="sequential"
  data-cover-state="neutral"
  transition:persist="music-player"
>
  <button
    class="music-player__toggle icon-link"
    type="button"
    data-player-toggle
    aria-label="打开背景音乐"
    aria-expanded="false"
    title="背景音乐"
  >
    <Music2 size={18} strokeWidth={1.7} />
    <span class="music-player__status" aria-hidden="true"></span>
  </button>

  <section class="music-panel" data-music-panel hidden aria-label="背景音乐播放器">
    <button
      class="music-panel__catalog-toggle"
      type="button"
      data-player-catalog-toggle
      aria-label="打开音乐目录"
      aria-expanded="false"
      aria-controls="music-catalog"
      title="音乐目录"
    >
      <Menu size={17} strokeWidth={1.6} />
    </button>
    <p class="music-panel__position" data-player-position>1/{tracks.length}</p>
    <div class="music-panel__now-playing" data-player-now-playing>
      <div class="music-panel__record">
        <div class="music-panel__turntable" data-player-turntable>
          <div class="music-panel__platter" data-player-platter aria-hidden="true">
            <span class="music-panel__neutral-label">RY</span>
            <img
              class="music-panel__cover music-panel__cover--current"
              data-player-cover-current
              width="54"
              height="54"
              alt=""
            />
            <img
              class="music-panel__cover music-panel__cover--incoming"
              data-player-cover-incoming
              alt=""
              hidden
            />
            <span class="music-panel__spindle"></span>
          </div>
          <div class="music-panel__tonearm" data-player-tonearm aria-hidden="true">
            <span class="music-panel__tonearm-pivot"></span>
            <span class="music-panel__tonearm-shaft"></span>
            <span class="music-panel__tonearm-head" data-player-needle></span>
          </div>
          <span class="music-panel__arm-rest" aria-hidden="true"></span>
          <button
            class="music-panel__cover-context"
            type="button"
            data-player-context-trigger
            data-context-kind="album"
            data-context-id={tracks[0].context.albumId}
            data-context-image={tracks[0].cover}
            aria-label={`查看《${tracks[0].album}》专辑背景`}
            title="查看专辑背景"
          ></button>
        </div>
        <div class="music-panel__copy">
          <p class="music-panel__eyebrow">Now playing</p>
          <button
            class="music-panel__title music-panel__context-link"
            type="button"
            data-player-title
            data-player-context-trigger
            data-context-kind="track"
            data-context-id={tracks[0].context.trackId}
            data-context-image={tracks[0].cover}
          >{tracks[0].title}</button>
          <button
            class="music-panel__artist music-panel__context-link"
            type="button"
            data-player-artist
            data-player-context-trigger
            data-context-kind="artist"
            data-context-id={tracks[0].context.artistId}
          >{tracks[0].artist}</button>
          <button
            class="music-panel__album music-panel__context-link"
            type="button"
            data-player-album
            data-player-context-trigger
            data-context-kind="album"
            data-context-id={tracks[0].context.albumId}
            data-context-image={tracks[0].cover}
          >{tracks[0].album}</button>
        </div>
      </div>

      <div class="music-panel__timeline">
        <time data-player-current-time>0:00</time>
        <div class="music-panel__progress" data-player-progress aria-hidden="true"></div>
        <time data-player-duration>--:--</time>
      </div>

      <p class="music-panel__message" data-player-message role="status" aria-live="polite"></p>
    </div>

    <section
      class="music-catalog"
      id="music-catalog"
      data-player-catalog
      aria-label="音乐目录"
      hidden
    >
      <h2 class="music-catalog__title">音乐目录</h2>
      <button class="music-catalog__context-entry" type="button" data-player-context-library>
        <span class="music-catalog__context-icon" aria-hidden="true">
          <BookOpenText size={21} strokeWidth={1.45} />
        </span>
        <span class="music-catalog__context-copy">
          <small>Listening notes</small>
          <strong>背景资料板</strong>
        </span>
        <span class="music-catalog__context-index">人物 · 专辑 · 曲目</span>
      </button>
      {
        catalogGroups.map((artist) => (
          <section class="music-catalog__artist">
            <h3>{artist.artist}</h3>
            {artist.albums.map((album) => (
              <div class="music-catalog__album">
                <div class="music-catalog__album-heading">
                  <img src={album.cover} width="36" height="36" alt="" />
                  <p>{album.album}</p>
                </div>
                <ol>
                  {album.tracks.map((track) => (
                    <li>
                      <button
                        type="button"
                        data-player-track
                        data-track-index={track.index}
                        aria-current={track.index === 0 ? "true" : undefined}
                      >
                        <span>{String(track.trackNumber).padStart(2, "0")}</span>
                        <span>{track.title}</span>
                      </button>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </section>
        ))
      }
    </section>

    <section class="music-context" data-player-context hidden aria-label="音乐背景资料板">
      <header class="music-context__header">
        <button
          class="music-context__back"
          type="button"
          data-player-context-back
          aria-label="返回资料索引"
          title="返回资料索引"
          hidden
        >
          <ArrowLeft size={17} strokeWidth={1.6} />
        </button>
        <div>
          <p>Listening notes</p>
          <h2>背景资料板</h2>
        </div>
        <button
          class="music-context__close"
          type="button"
          data-player-context-close
          aria-label="关闭背景资料板"
          title="关闭背景资料板"
        >
          <X size={18} strokeWidth={1.6} />
        </button>
      </header>

      <p class="music-context__status" data-player-context-status role="status" aria-live="polite"></p>

      <div class="music-context__overview" data-player-context-overview hidden>
        <p class="music-context__overview-label">当前唱片档案</p>
        <h3 data-player-context-overview-title>{tracks[0].title}</h3>
        <p data-player-context-overview-caption>{tracks[0].artist} · {tracks[0].album}</p>
        <div class="music-context__choices">
          <button type="button" data-player-context-choice data-context-kind="artist">
            <span>人物</span><strong data-player-context-choice-artist>{tracks[0].artist}</strong>
          </button>
          <button type="button" data-player-context-choice data-context-kind="album">
            <span>专辑</span><strong data-player-context-choice-album>{tracks[0].album}</strong>
          </button>
          <button type="button" data-player-context-choice data-context-kind="track">
            <span>曲目</span><strong data-player-context-choice-track>{tracks[0].title}</strong>
          </button>
        </div>
      </div>

      <article class="music-context__article" data-player-context-article hidden>
        <img class="music-context__image" data-player-context-image alt="" hidden />
        <div class="music-context__heading">
          <p data-player-context-kind></p>
          <h3 data-player-context-title></h3>
          <p data-player-context-subtitle></p>
        </div>
        <dl class="music-context__meta" data-player-context-meta hidden></dl>
        <div class="music-context__prose" data-player-context-prose></div>
        <a class="music-context__source" data-player-context-source target="_blank" rel="noreferrer">
          核验来源与图片授权
          <ExternalLink size={14} strokeWidth={1.6} />
        </a>
      </article>
    </section>

    <div class="music-panel__controls">
      <span class="music-panel__control-spacer" aria-hidden="true"></span>
      <button type="button" data-player-previous aria-label="上一首" title="上一首">
        <SkipBack size={19} fill="currentColor" strokeWidth={1.5} />
      </button>
      <button
        class="music-panel__play"
        type="button"
        data-player-play
        aria-label="播放"
        title="播放或暂停"
      >
        <span data-player-play-icon><Play size={20} fill="currentColor" strokeWidth={1.4} /></span>
        <span data-player-pause-icon hidden><Pause size={20} fill="currentColor" strokeWidth={1.4} /></span>
      </button>
      <button type="button" data-player-next aria-label="下一首" title="下一首">
        <SkipForward size={19} fill="currentColor" strokeWidth={1.5} />
      </button>
      <button
        class="music-panel__mode-toggle"
        type="button"
        data-player-mode
        aria-pressed="false"
        aria-label="当前为顺序播放，点击切换为随机播放"
        title="当前为顺序播放，点击切换为随机播放"
      >
        <span class="music-panel__mode-icon" data-player-mode-sequential>
          <ListEnd size={19} strokeWidth={1.6} />
        </span>
        <span class="music-panel__mode-icon" data-player-mode-shuffle hidden>
          <Shuffle size={19} strokeWidth={1.6} />
        </span>
      </button>
    </div>
  </section>

  <audio data-player-audio preload="metadata" playsinline></audio>
</div>

<script>
  import "../scripts/music-player";
</script>
