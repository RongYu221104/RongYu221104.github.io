---
import BaseLayout from "../layouts/BaseLayout.astro";
import LectureArchive from "../components/LectureArchive.astro";
import { RotateCcw, Tags } from "lucide-astro";
import { lectureKindLabels, lectures, type LectureKind } from "../data/lectures";

const subjectFilters = [
  { value: "maths", label: "Math", title: "数学" },
  { value: "physics", label: "Phys", title: "物理" },
];
const kindFilters = (["Stu", "Lec", "Rev", "Aux"] as LectureKind[]).map((kind) => ({
  value: kind,
  label: kind,
  title: lectureKindLabels[kind],
}));
const coursesByCode = new Map(lectures.map((lecture) => [lecture.course.code, lecture.course]));
const courseSequence = [
  // 代数学
  "LA", "AA", "GRT", "LGLA",
  // 分析学
  "ODE", "PS", "MP",
  // 几何学
  "DG",
  // 经典物理
  "CM", "TH", "EM", "OP", "ED", "SR",
  // 量子物理
  "AP", "QM",
];
const courseFilters = courseSequence.flatMap((code) => {
  const course = coursesByCode.get(code);
  return course ? [course] : [];
});
---

<BaseLayout
  title="LaTeX 讲义"
  description="容与的数学与物理 LaTeX 讲义，可在线预览或下载 PDF。"
  pageClass="archive-page"
>
  <header class="page-intro section-shell">
    <p class="page-intro__kicker">LaTeX archive · {lectures.length} scores</p>
    <h1>讲义目录</h1>
    <p>数学与物理，各自成章。学习、课程与复习讲义依次排列。</p>
  </header>

  <section class="archive-filter section-shell" aria-labelledby="lecture-filter-title" data-lecture-filter>
    <header class="archive-filter__header">
      <div>
        <Tags size={18} strokeWidth={1.7} aria-hidden="true" />
        <h2 id="lecture-filter-title">按标签筛选</h2>
      </div>
      <p data-lecture-filter-status aria-live="polite">{lectures.length} 份讲义</p>
      <button type="button" class="archive-filter__reset" data-filter-reset disabled>
        <RotateCcw size={14} strokeWidth={1.8} aria-hidden="true" />
        清除
      </button>
    </header>
    <div class="archive-filter__groups">
      <div class="archive-filter__primary-row">
        <div class="archive-filter__group" role="group" aria-label="学科">
          <span class="archive-filter__group-label" aria-hidden="true">学科 <small>Subject</small></span>
          <div>
            {subjectFilters.map((tag) => (
              <button type="button" data-filter-group="subject" data-filter-value={tag.value} aria-pressed="false" title={tag.title}>{tag.label}</button>
            ))}
          </div>
        </div>
        <span class="archive-filter__divider" aria-hidden="true">|</span>
        <div class="archive-filter__group" role="group" aria-label="用途">
          <span class="archive-filter__group-label" aria-hidden="true">用途 <small>Kind</small></span>
          <div>
            {kindFilters.map((tag) => (
              <button type="button" data-filter-group="kind" data-filter-value={tag.value} aria-pressed="false" title={tag.title}>{tag.label}</button>
            ))}
          </div>
        </div>
      </div>
      <div class="archive-filter__group archive-filter__group--courses" role="group" aria-label="课程">
        <span class="archive-filter__group-label" aria-hidden="true">课程 <small>Course</small></span>
        <div>
          {courseFilters.map((tag) => (
            <button type="button" data-filter-group="course" data-filter-value={tag.code} aria-pressed="false" title={`${tag.titleZh} · ${tag.titleEn}`}>{tag.code}</button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <p class="archive-filter__empty section-shell" data-filter-empty hidden>
    没有符合当前标签组合的讲义，请取消一个标签或清除筛选。
  </p>

  <div class="archive-grid section-shell">
    <div id="maths">
      <LectureArchive subject="maths" titleZh="数学" titleEn="Mathematics" />
    </div>
    <div id="physics">
      <LectureArchive subject="physics" titleZh="物理" titleEn="Physics" />
    </div>
  </div>
</BaseLayout>

<script>
  function initializeLectureArchive() {
    const filter = document.querySelector<HTMLElement>("[data-lecture-filter]");
    const status = filter?.querySelector<HTMLElement>("[data-lecture-filter-status]");
    const reset = filter?.querySelector<HTMLButtonElement>("[data-filter-reset]");
    const empty = document.querySelector<HTMLElement>("[data-filter-empty]");
    const buttons = Array.from(filter?.querySelectorAll<HTMLButtonElement>("[data-filter-group]") ?? []);
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-lecture-card]"));
    if (!filter || !status || !reset || !empty || buttons.length === 0 || cards.length === 0 || filter.dataset.ready === "true") return;
    const archiveWindow = window as typeof window & {
      __rongYuArchiveController?: AbortController;
    };
    archiveWindow.__rongYuArchiveController?.abort();
    const controller = new AbortController();
    archiveWindow.__rongYuArchiveController = controller;
    filter.dataset.ready = "true";

    let selectedIndex = -1;
    const selected = {
      subject: new Set<string>(),
      kind: new Set<string>(),
      course: new Set<string>(),
    };

    const visibleCards = () => cards.filter((card) => !card.hidden);

    const selectCard = (index: number, focus = true) => {
      const visible = visibleCards();
      if (visible.length === 0) return;
      selectedIndex = (index + visible.length) % visible.length;
      cards.forEach((card) => card.removeAttribute("data-selected"));
      const selected = visible[selectedIndex];
      selected.setAttribute("data-selected", "true");
      if (focus) {
        const folder = selected.closest<HTMLDetailsElement>("[data-lecture-course]");
        if (folder) folder.open = true;
        selected.focus({ preventScroll: true });
        selected.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    };

    const filterCards = () => {
      cards.forEach((card) => {
        card.hidden = !(
          (selected.subject.size === 0 || selected.subject.has(card.dataset.subject ?? ""))
          && (selected.kind.size === 0 || selected.kind.has(card.dataset.kind ?? ""))
          && (selected.course.size === 0 || selected.course.has(card.dataset.course ?? ""))
        );
        card.removeAttribute("data-selected");
      });
      const hasFilters = Object.values(selected).some((values) => values.size > 0);
      document.querySelectorAll<HTMLDetailsElement>("[data-lecture-course]").forEach((folder) => {
        const hasMatch = Boolean(folder.querySelector("[data-lecture-card]:not([hidden])"));
        folder.hidden = !hasMatch;
        folder.open = hasFilters && hasMatch
          ? true
          : folder.dataset.defaultOpen === "true";
      });
      document.querySelectorAll<HTMLElement>(".lecture-group").forEach((group) => {
        group.hidden = !group.querySelector("[data-lecture-card]:not([hidden])");
      });
      document.querySelectorAll<HTMLElement>(".archive-column").forEach((column) => {
        column.hidden = !column.querySelector("[data-lecture-card]:not([hidden])");
      });
      const count = visibleCards().length;
      selectedIndex = -1;
      reset.disabled = !hasFilters;
      empty.hidden = count !== 0;
      status.textContent = hasFilters ? `${count} / ${cards.length} 份讲义` : `${count} 份讲义`;
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const group = button.dataset.filterGroup as keyof typeof selected;
        const value = button.dataset.filterValue ?? "";
        const values = selected[group];
        if (values.has(value)) values.delete(value);
        else values.add(value);
        button.setAttribute("aria-pressed", String(values.has(value)));
        filterCards();
      }, { signal: controller.signal });
    });
    reset.addEventListener("click", () => {
      Object.values(selected).forEach((values) => values.clear());
      buttons.forEach((button) => button.setAttribute("aria-pressed", "false"));
      filterCards();
    }, { signal: controller.signal });
    cards.forEach((card) => {
      card.addEventListener("focus", () => {
        selectedIndex = visibleCards().indexOf(card);
        cards.forEach((item) => item.removeAttribute("data-selected"));
        card.setAttribute("data-selected", "true");
      });
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement;
      const isEditable = target.matches("input, textarea, select, button, a, [contenteditable='true']");
      if (isEditable || event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.key === "j" || event.key === "k") {
        event.preventDefault();
        selectCard(selectedIndex + (event.key === "j" ? 1 : -1));
      } else if (event.key === "Enter" && selectedIndex >= 0) {
        const url = visibleCards()[selectedIndex]?.dataset.previewUrl;
        if (url) window.location.href = url;
      }
    }, { signal: controller.signal });

    document.querySelectorAll<HTMLButtonElement>("[data-lecture-share]").forEach((button) => {
      button.addEventListener("click", async () => {
        const share = {
          title: button.dataset.shareTitle,
          text: button.dataset.shareText,
          url: new URL(button.dataset.shareUrl || "/latex/", window.location.origin).href,
        };
        let shared = false;
        try {
          if (navigator.share) {
            await navigator.share(share);
            shared = true;
          } else {
            await navigator.clipboard.writeText(share.url);
            shared = true;
          }
        } catch (error) {
          if (error instanceof DOMException && error.name === "AbortError") return;
          try {
            await navigator.clipboard.writeText(share.url);
            shared = true;
          } catch {
            window.prompt("复制讲义链接", share.url);
            shared = true;
          }
        }
        if (!shared) return;
        const originalLabel = button.getAttribute("aria-label") || "分享讲义";
        button.classList.add("is-confirmed");
        button.setAttribute("aria-label", "分享链接已准备");
        window.setTimeout(() => {
          button.classList.remove("is-confirmed");
          button.setAttribute("aria-label", originalLabel);
        }, 1600);
      });
    });
    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true });
  }

  initializeLectureArchive();
  document.addEventListener("astro:page-load", initializeLectureArchive);
</script>
