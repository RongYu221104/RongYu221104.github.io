---
import {
  ArrowLeft,
  BookOpen,
  ChevronLeft,
  ChevronRight,
  Download,
  File,
  ListTree,
  Maximize2,
  MoveHorizontal,
  MoveVertical,
  Rows3,
  ZoomIn,
  ZoomOut,
} from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="讲义阅读"
  description="RongYu's Notes 讲义阅读器。"
  pageClass="viewer-page"
  hideFooter={true}
>
  <section class="lecture-viewer" aria-labelledby="viewer-title" data-lecture-viewer>
    <header class="lecture-viewer__toolbar">
      <a class="lecture-viewer__back" href="/latex/" aria-label="返回讲义目录" title="返回讲义目录">
        <ArrowLeft size={18} strokeWidth={1.7} />
        <span>讲义目录</span>
      </a>

      <div class="lecture-viewer__identity">
        <p>RongYu's Reader</p>
        <h1 id="viewer-title">正在准备讲义</h1>
      </div>

      <div class="lecture-viewer__controls" aria-label="阅读控制">
        <button type="button" data-viewer-outline-toggle aria-label="显示目录" title="目录" aria-expanded="false">
          <ListTree size={18} strokeWidth={1.7} />
        </button>

        <span class="lecture-viewer__control-divider" aria-hidden="true"></span>

        <div class="lecture-viewer__mode-group" role="group" aria-label="预览方式">
          <button type="button" data-viewer-mode="single" aria-label="单页预览" title="单页预览" aria-pressed="true">
            <File size={18} strokeWidth={1.7} />
          </button>
          <button type="button" data-viewer-mode="spread" aria-label="双页预览" title="双页预览" aria-pressed="false">
            <BookOpen size={18} strokeWidth={1.7} />
          </button>
          <button type="button" data-viewer-mode="continuous" aria-label="连续预览" title="连续预览" aria-pressed="false">
            <Rows3 size={18} strokeWidth={1.7} />
          </button>
        </div>

        <span class="lecture-viewer__control-divider" aria-hidden="true"></span>

        <button type="button" data-viewer-previous aria-label="上一页" title="上一页" disabled>
          <ChevronLeft size={20} strokeWidth={1.7} />
        </button>
        <label class="lecture-viewer__page-status" aria-label="当前页码">
          <input type="number" min="1" value="1" data-viewer-page-input disabled />
          <span>/</span>
          <span data-viewer-total>--</span>
        </label>
        <button type="button" data-viewer-next aria-label="下一页" title="下一页" disabled>
          <ChevronRight size={20} strokeWidth={1.7} />
        </button>

        <span class="lecture-viewer__control-divider" aria-hidden="true"></span>

        <button type="button" data-viewer-zoom-out aria-label="缩小" title="缩小" disabled>
          <ZoomOut size={18} strokeWidth={1.7} />
        </button>
        <button type="button" data-viewer-zoom-in aria-label="放大" title="放大" disabled>
          <ZoomIn size={18} strokeWidth={1.7} />
        </button>
        <button type="button" data-viewer-fit-width aria-label="横向适配屏幕" title="横向适配屏幕" aria-pressed="true" disabled>
          <MoveHorizontal size={18} strokeWidth={1.7} />
        </button>
        <button type="button" data-viewer-fit-height aria-label="纵向适配屏幕" title="纵向适配屏幕" aria-pressed="false" disabled>
          <MoveVertical size={18} strokeWidth={1.7} />
        </button>
        <button type="button" data-viewer-fullscreen aria-label="全屏" title="全屏" aria-pressed="false">
          <Maximize2 size={18} strokeWidth={1.7} />
        </button>
      </div>

      <a
        class="lecture-viewer__download"
        href="/latex/"
        download
        aria-label="下载讲义"
        title="下载讲义"
        data-viewer-download
      >
        <Download size={18} strokeWidth={1.7} />
        <span>下载</span>
      </a>
    </header>

    <div class="lecture-viewer__body" data-viewer-body data-outline-open="false">
      <aside class="lecture-viewer__outline" data-viewer-outline hidden>
        <header>
          <p>Contents</p>
          <h2>目录</h2>
        </header>
        <nav data-viewer-outline-list aria-label="讲义目录">
          <p class="lecture-viewer__outline-empty">正在读取目录</p>
        </nav>
      </aside>

      <div class="lecture-viewer__stage" data-viewer-stage aria-live="polite">
        <div class="lecture-viewer__message" data-viewer-message>
          <span class="lecture-viewer__loading-mark" aria-hidden="true"></span>
          <p>正在载入讲义</p>
        </div>
        <div class="lecture-viewer__pages" data-viewer-pages data-mode="single"></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script is:inline>
  (() => {
    const allowedLecturePath = /^\/lectures\/(maths|physics)\/[^/]+\.pdf$/;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const state = {
      documentTask: null,
      pdfDocument: null,
      mode: "single",
      fit: "width",
      zoom: 1,
      currentPage: 1,
      generation: 0,
      observer: null,
      renderTasks: new Set(),
      resizeTimer: 0,
      layoutRequest: 0,
    };

    function clampPage(page) {
      return Math.min(Math.max(Number(page) || 1, 1), state.pdfDocument?.numPages || 1);
    }

    function cancelRenders() {
      state.generation += 1;
      state.observer?.disconnect();
      state.observer = null;
      state.renderTasks.forEach((task) => task.cancel());
      state.renderTasks.clear();
    }

    async function destroyDocument() {
      cancelRenders();
      await state.pdfDocument?.destroy();
      state.pdfDocument = null;
      await state.documentTask?.destroy();
      state.documentTask = null;
    }

    async function initialiseViewer() {
      const viewer = document.querySelector("[data-lecture-viewer]");
      if (!viewer || viewer.dataset.initialised === "true") return;
      viewer.dataset.initialised = "true";

      const elements = {
        viewer,
        body: viewer.querySelector("[data-viewer-body]"),
        stage: viewer.querySelector("[data-viewer-stage]"),
        pages: viewer.querySelector("[data-viewer-pages]"),
        message: viewer.querySelector("[data-viewer-message]"),
        title: viewer.querySelector("#viewer-title"),
        download: viewer.querySelector("[data-viewer-download]"),
        outline: viewer.querySelector("[data-viewer-outline]"),
        outlineList: viewer.querySelector("[data-viewer-outline-list]"),
        outlineToggle: viewer.querySelector("[data-viewer-outline-toggle]"),
        previous: viewer.querySelector("[data-viewer-previous]"),
        next: viewer.querySelector("[data-viewer-next]"),
        pageInput: viewer.querySelector("[data-viewer-page-input]"),
        total: viewer.querySelector("[data-viewer-total]"),
        zoomOut: viewer.querySelector("[data-viewer-zoom-out]"),
        zoomIn: viewer.querySelector("[data-viewer-zoom-in]"),
        fitWidth: viewer.querySelector("[data-viewer-fit-width]"),
        fitHeight: viewer.querySelector("[data-viewer-fit-height]"),
        fullscreen: viewer.querySelector("[data-viewer-fullscreen]"),
        modeButtons: [...viewer.querySelectorAll("[data-viewer-mode]")],
      };

      if (Object.values(elements).some((value) => value == null)) return;

      const params = new URLSearchParams(window.location.search);
      const requestedFile = params.get("file");
      const requestedTitle = params.get("title") || "讲义阅读";
      let pdfUrl;

      try {
        const candidate = new URL(requestedFile || "", window.location.origin);
        if (candidate.origin !== window.location.origin || !allowedLecturePath.test(candidate.pathname)) {
          throw new Error("请从讲义目录选择需要阅读的讲义。");
        }
        pdfUrl = `${candidate.pathname}${candidate.search}`;
      } catch (error) {
        showError(error.message || "讲义链接无效。");
        return;
      }

      elements.title.textContent = requestedTitle;
      document.title = `${requestedTitle} | RongYu's Notes`;
      elements.download.href = pdfUrl;
      elements.download.download = decodeURIComponent(pdfUrl.split("/").pop() || "lecture.pdf");
      const progressKey = `rongyu-notes.reader-progress.v1:${pdfUrl}`;

      function loadProgress() {
        try {
          return Number(localStorage.getItem(progressKey)) || 1;
        } catch {
          return 1;
        }
      }

      function saveProgress() {
        if (!state.pdfDocument) return;
        try {
          localStorage.setItem(progressKey, String(state.currentPage));
        } catch {
          // Reading remains available when browser storage is disabled.
        }
      }

      const pdfjs = window.pdfjsLib;
      if (!pdfjs?.getDocument) {
        showError("阅读器资源未能载入，请刷新页面后重试。");
        return;
      }
      pdfjs.GlobalWorkerOptions.workerSrc = "https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js";

      function showError(text) {
        elements.title.textContent = "无法打开讲义";
        elements.message.hidden = false;
        elements.message.innerHTML = '<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 8v5m0 4h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg><p></p>';
        elements.message.querySelector("p").textContent = text;
      }

      function updateControls() {
        const ready = Boolean(state.pdfDocument);
        const step = state.mode === "spread" ? 2 : 1;
        elements.pageInput.disabled = !ready;
        elements.pageInput.max = String(state.pdfDocument?.numPages || 1);
        elements.pageInput.value = String(state.currentPage);
        elements.total.textContent = ready ? String(state.pdfDocument.numPages) : "--";
        elements.previous.disabled = !ready || state.currentPage <= 1;
        elements.next.disabled = !ready || state.currentPage + step > state.pdfDocument.numPages;
        elements.zoomOut.disabled = !ready || state.zoom <= 0.55;
        elements.zoomIn.disabled = !ready || state.zoom >= 2.4;
        elements.fitWidth.disabled = !ready;
        elements.fitHeight.disabled = !ready;
        elements.fitWidth.setAttribute("aria-pressed", String(state.fit === "width"));
        elements.fitHeight.setAttribute("aria-pressed", String(state.fit === "height"));
        elements.modeButtons.forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.viewerMode === state.mode));
        });
        if (ready) saveProgress();
      }

      function pageNumbersForCurrentView() {
        if (state.mode === "spread") {
          return [state.currentPage, state.currentPage + 1].filter((page) => page <= state.pdfDocument.numPages);
        }
        return [state.currentPage];
      }

      async function scaleForPage(page, pagesInRow = 1) {
        const base = page.getViewport({ scale: 1 });
        const horizontalPadding = state.mode === "continuous" ? 52 : 64;
        const availableWidth = Math.max(260, elements.stage.clientWidth - horizontalPadding);
        const availableHeight = Math.max(260, elements.stage.clientHeight - 48);
        const widthPerPage = pagesInRow === 2 ? (availableWidth - 22) / 2 : availableWidth;
        const fitted = state.fit === "height"
          ? availableHeight / base.height
          : widthPerPage / base.width;
        return Math.min(Math.max(fitted * state.zoom, 0.25), 3);
      }

      function createPageFrame(pageNumber, template) {
        const frame = document.createElement("article");
        frame.className = "lecture-viewer__page";
        frame.dataset.pageNumber = String(pageNumber);
        frame.setAttribute("aria-label", `第 ${pageNumber} 页`);

        const surface = document.createElement("div");
        surface.className = "lecture-viewer__page-surface";
        surface.style.width = `${template.width}px`;
        surface.style.height = `${template.height}px`;

        const canvas = document.createElement("canvas");
        canvas.hidden = true;
        const links = document.createElement("div");
        links.className = "lecture-viewer__link-layer";
        const placeholder = document.createElement("span");
        placeholder.className = "lecture-viewer__page-placeholder";
        placeholder.textContent = String(pageNumber);

        surface.append(canvas, links, placeholder);
        frame.append(surface);
        return frame;
      }

      function unrenderFrame(frame) {
        if (frame.dataset.near === "true") return;
        frame._renderTask?.cancel();
        frame._renderTask = null;
        const canvas = frame.querySelector("canvas");
        const links = frame.querySelector(".lecture-viewer__link-layer");
        const placeholder = frame.querySelector(".lecture-viewer__page-placeholder");
        canvas.width = 1;
        canvas.height = 1;
        canvas.hidden = true;
        links.replaceChildren();
        placeholder.hidden = false;
        delete frame.dataset.renderedKey;
        delete frame.dataset.renderingKey;
      }

      async function renderFrame(frame) {
        const pageNumber = Number(frame.dataset.pageNumber);
        const generation = state.generation;
        const page = await state.pdfDocument.getPage(pageNumber);
        const pagesInRow = state.mode === "spread" ? 2 : 1;
        const displayScale = await scaleForPage(page, pagesInRow);
        const renderedKey = `${generation}:${displayScale.toFixed(4)}`;
        if (frame.dataset.renderedKey === renderedKey) return;
        if (frame.dataset.renderingKey === renderedKey) return;
        frame._renderTask?.cancel();
        frame.dataset.renderingKey = renderedKey;

        const displayViewport = page.getViewport({ scale: displayScale });
        const pixelScale = Math.min(window.devicePixelRatio || 1, 2);
        const renderViewport = page.getViewport({ scale: displayScale * pixelScale });
        const surface = frame.querySelector(".lecture-viewer__page-surface");
        const canvas = frame.querySelector("canvas");
        const links = frame.querySelector(".lecture-viewer__link-layer");
        const placeholder = frame.querySelector(".lecture-viewer__page-placeholder");
        const context = canvas.getContext("2d", { alpha: false });
        if (!context || generation !== state.generation) return;

        surface.style.width = `${Math.ceil(displayViewport.width)}px`;
        surface.style.height = `${Math.ceil(displayViewport.height)}px`;
        canvas.width = Math.ceil(renderViewport.width);
        canvas.height = Math.ceil(renderViewport.height);
        canvas.style.width = `${Math.ceil(displayViewport.width)}px`;
        canvas.style.height = `${Math.ceil(displayViewport.height)}px`;
        links.style.width = `${Math.ceil(displayViewport.width)}px`;
        links.style.height = `${Math.ceil(displayViewport.height)}px`;
        frame._viewport = displayViewport;

        const task = page.render({ canvasContext: context, viewport: renderViewport });
        frame._renderTask = task;
        state.renderTasks.add(task);
        try {
          await task.promise;
        } catch (error) {
          if (error?.name !== "RenderingCancelledException") throw error;
        } finally {
          state.renderTasks.delete(task);
        }
        if (generation !== state.generation) return;

        canvas.hidden = false;
        placeholder.hidden = true;
        links.replaceChildren();
        const annotations = await page.getAnnotations({ intent: "display" });
        if (generation !== state.generation) return;
        annotations.filter((annotation) => annotation.subtype === "Link").forEach((annotation) => {
          const rect = displayViewport.convertToViewportRectangle(annotation.rect);
          const link = document.createElement("a");
          link.className = "lecture-viewer__pdf-link";
          link.style.left = `${Math.min(rect[0], rect[2])}px`;
          link.style.top = `${Math.min(rect[1], rect[3])}px`;
          link.style.width = `${Math.max(Math.abs(rect[2] - rect[0]), 3)}px`;
          link.style.height = `${Math.max(Math.abs(rect[3] - rect[1]), 3)}px`;
          link.setAttribute("aria-label", "PDF 链接");

          if (annotation.url || annotation.unsafeUrl) {
            link.href = annotation.url || annotation.unsafeUrl;
            link.target = "_blank";
            link.rel = "noreferrer";
          } else if (annotation.dest) {
            link.href = "#";
            link.addEventListener("click", (event) => {
              event.preventDefault();
              navigateToDestination(annotation.dest);
            });
          } else if (annotation.action) {
            link.href = "#";
            link.addEventListener("click", (event) => {
              event.preventDefault();
              runNamedAction(annotation.action);
            });
          } else {
            return;
          }
          links.append(link);
        });
        frame.dataset.renderedKey = renderedKey;
        delete frame.dataset.renderingKey;
      }

      function createObserver() {
        state.observer?.disconnect();
        state.observer = new IntersectionObserver((entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting);
          visible.forEach((entry) => {
            entry.target.dataset.near = "true";
            renderFrame(entry.target);
          });
          entries.filter((entry) => !entry.isIntersecting).forEach((entry) => {
            entry.target.dataset.near = "false";
            window.setTimeout(() => unrenderFrame(entry.target), 900);
          });

          const closest = visible
            .filter((entry) => entry.intersectionRatio > 0)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (closest) {
            state.currentPage = Number(closest.target.dataset.pageNumber);
            updateControls();
          }
        }, {
          root: elements.stage,
          rootMargin: "900px 0px",
          threshold: [0, 0.15, 0.5, 0.85],
        });
      }

      async function renderView() {
        if (!state.pdfDocument) return false;
        cancelRenders();
        const generation = state.generation;
        elements.pages.replaceChildren();
        elements.pages.dataset.mode = state.mode;
        const firstPage = await state.pdfDocument.getPage(state.currentPage);
        if (generation !== state.generation) return false;
        const templateScale = await scaleForPage(firstPage, state.mode === "spread" ? 2 : 1);
        if (generation !== state.generation) return false;
        const templateViewport = firstPage.getViewport({ scale: templateScale });
        const template = {
          width: Math.ceil(templateViewport.width),
          height: Math.ceil(templateViewport.height),
        };

        const numbers = state.mode === "continuous"
          ? Array.from({ length: state.pdfDocument.numPages }, (_, index) => index + 1)
          : pageNumbersForCurrentView();
        numbers.forEach((number) => elements.pages.append(createPageFrame(number, template)));

        if (state.mode === "continuous") {
          createObserver();
          [...elements.pages.children].forEach((frame) => state.observer.observe(frame));
        } else {
          await Promise.all([...elements.pages.children].map((frame) => renderFrame(frame)));
          if (generation !== state.generation) return false;
          elements.stage.scrollTo({ top: 0, left: 0 });
        }
        updateControls();
        return generation === state.generation;
      }

      async function destinationArray(destination) {
        return typeof destination === "string"
          ? state.pdfDocument.getDestination(destination)
          : destination;
      }

      async function pageNumberForDestination(destination) {
        const resolved = await destinationArray(destination);
        if (!resolved?.[0]) return null;
        const pageIndex = Number.isInteger(resolved[0])
          ? resolved[0]
          : await state.pdfDocument.getPageIndex(resolved[0]);
        return { pageNumber: pageIndex + 1, resolved };
      }

      async function scrollToResolvedDestination(frame, resolved) {
        const type = resolved?.[1]?.name;
        const pdfTop = type === "XYZ" ? resolved[3]
          : (type === "FitH" || type === "FitBH") ? resolved[2]
          : type === "FitR" ? resolved[5]
          : null;
        let top = frame.offsetTop - 16;
        if (Number.isFinite(pdfTop) && frame._viewport) {
          const point = frame._viewport.convertToViewportPoint(0, pdfTop);
          top += point[1];
        }
        elements.stage.scrollTo({
          top: Math.max(top, 0),
          behavior: prefersReducedMotion.matches ? "auto" : "smooth",
        });
      }

      async function navigateToDestination(destination) {
        const target = await pageNumberForDestination(destination);
        if (!target) return;
        state.currentPage = clampPage(target.pageNumber);
        if (state.mode !== "continuous") await renderView();
        const frame = elements.pages.querySelector(`[data-page-number="${state.currentPage}"]`);
        if (!frame) return;
        frame.dataset.near = "true";
        await renderFrame(frame);
        await scrollToResolvedDestination(frame, target.resolved);
        updateControls();
      }

      function runNamedAction(action) {
        const destinations = {
          FirstPage: 1,
          LastPage: state.pdfDocument.numPages,
          NextPage: state.currentPage + 1,
          PrevPage: state.currentPage - 1,
        };
        if (destinations[action]) goToPage(destinations[action]);
      }

      async function goToPage(page) {
        state.currentPage = clampPage(page);
        if (state.mode === "continuous") {
          const frame = elements.pages.querySelector(`[data-page-number="${state.currentPage}"]`);
          if (frame) {
            frame.dataset.near = "true";
            await renderFrame(frame);
            frame.scrollIntoView({ behavior: prefersReducedMotion.matches ? "auto" : "smooth", block: "start" });
          }
        } else {
          await renderView();
        }
        updateControls();
      }

      function buildOutline(items) {
        const list = document.createElement("ul");
        items.forEach((item) => {
          const entry = document.createElement("li");
          let control;
          if (item.url) {
            control = document.createElement("a");
            control.href = item.url;
            control.target = "_blank";
            control.rel = "noreferrer";
          } else if (item.dest) {
            control = document.createElement("button");
            control.type = "button";
            control.addEventListener("click", () => navigateToDestination(item.dest));
          } else {
            control = document.createElement("span");
          }
          control.textContent = item.title || "未命名章节";
          entry.append(control);
          if (item.items?.length) entry.append(buildOutline(item.items));
          list.append(entry);
        });
        return list;
      }

      async function renderOutline() {
        const outline = await state.pdfDocument.getOutline();
        elements.outlineList.replaceChildren();
        if (!outline?.length) {
          const empty = document.createElement("p");
          empty.className = "lecture-viewer__outline-empty";
          empty.textContent = "这份讲义没有可读取的目录。";
          elements.outlineList.append(empty);
          return;
        }
        elements.outlineList.append(buildOutline(outline));
      }

      async function refreshLayout() {
        const page = state.currentPage;
        const rendered = await renderView();
        if (!rendered) return;
        if (state.mode === "continuous") await goToPage(page);
      }

      function scheduleLayoutRefresh() {
        const request = ++state.layoutRequest;
        window.requestAnimationFrame(() => {
          if (request === state.layoutRequest) refreshLayout();
        });
      }

      elements.outlineToggle.addEventListener("click", () => {
        const open = elements.body.dataset.outlineOpen !== "true";
        elements.body.dataset.outlineOpen = String(open);
        elements.outline.hidden = !open;
        elements.outlineToggle.setAttribute("aria-expanded", String(open));
        scheduleLayoutRefresh();
      });
      elements.modeButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          state.mode = button.dataset.viewerMode;
          await renderView();
        });
      });
      elements.previous.addEventListener("click", () => goToPage(state.currentPage - (state.mode === "spread" ? 2 : 1)));
      elements.next.addEventListener("click", () => goToPage(state.currentPage + (state.mode === "spread" ? 2 : 1)));
      elements.pageInput.addEventListener("change", () => goToPage(elements.pageInput.value));
      elements.pageInput.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          goToPage(elements.pageInput.value);
          elements.pageInput.blur();
        }
      });
      elements.zoomOut.addEventListener("click", async () => {
        state.zoom = Math.max(0.55, Number((state.zoom / 1.15).toFixed(3)));
        await refreshLayout();
      });
      elements.zoomIn.addEventListener("click", async () => {
        state.zoom = Math.min(2.4, Number((state.zoom * 1.15).toFixed(3)));
        await refreshLayout();
      });
      elements.fitWidth.addEventListener("click", async () => {
        state.fit = "width";
        state.zoom = 1;
        await refreshLayout();
      });
      elements.fitHeight.addEventListener("click", async () => {
        state.fit = "height";
        state.zoom = 1;
        await refreshLayout();
      });
      elements.fullscreen.addEventListener("click", async () => {
        if (document.fullscreenElement === viewer) await document.exitFullscreen();
        else await viewer.requestFullscreen();
      });
      document.addEventListener("fullscreenchange", () => {
        elements.fullscreen.setAttribute("aria-pressed", String(document.fullscreenElement === viewer));
      });
      window.addEventListener("resize", () => {
        window.clearTimeout(state.resizeTimer);
        state.resizeTimer = window.setTimeout(scheduleLayoutRefresh, 180);
      });

      try {
        state.documentTask = pdfjs.getDocument({ url: pdfUrl, isEvalSupported: false });
        state.pdfDocument = await state.documentTask.promise;
        state.currentPage = clampPage(loadProgress());
        elements.message.hidden = true;
        await Promise.all([renderOutline(), renderView()]);
      } catch (error) {
        console.error("Unable to load lecture", error);
        showError("讲义暂时无法载入，请返回目录后重试。");
      }
    }

    document.addEventListener("astro:page-load", initialiseViewer);
    document.addEventListener("astro:before-swap", destroyDocument);
  })();
</script>
