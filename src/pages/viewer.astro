---
import {
  ArrowLeft,
  BookOpen,
  Download,
  File,
  ListTree,
  Maximize2,
  MoveHorizontal,
  MoveVertical,
  MessageSquareText,
  PanelTopOpen,
  Rows3,
  X,
  ZoomIn,
  ZoomOut,
} from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
---

<BaseLayout
  title="讲义阅读"
  description="RongYu's Notes 讲义阅读器。"
  pageClass="viewer-page"
  hideHeader={true}
  hideFooter={true}
>
  <section
    class="lecture-viewer"
    aria-labelledby="viewer-title"
    data-lecture-viewer
    data-chrome-visible="true"
    data-navigation-state="idle"
    data-layout-state="idle"
  >
    <header class="lecture-viewer__toolbar">
      <a class="lecture-viewer__back" href="/latex/" aria-label="返回讲义目录" title="返回讲义目录">
        <ArrowLeft size={18} strokeWidth={1.7} />
        <span>讲义目录</span>
      </a>

      <div class="lecture-viewer__identity">
        <p>RongYu's Reader</p>
        <h1 id="viewer-title">正在准备讲义</h1>
      </div>

      <div class="lecture-viewer__controls" aria-label="阅读控制">
        <button type="button" data-viewer-outline-toggle aria-label="显示目录" title="目录" aria-expanded="false">
          <ListTree size={18} strokeWidth={1.7} />
          <span>目录</span>
        </button>

        <span class="lecture-viewer__control-divider" aria-hidden="true"></span>

        <div class="lecture-viewer__mode-group" role="group" aria-label="预览方式">
          <button type="button" data-viewer-mode="continuous" aria-label="连续预览" title="连续预览" aria-pressed="true">
            <Rows3 size={18} strokeWidth={1.7} />
          </button>
          <button type="button" data-viewer-mode="single" aria-label="单页预览" title="单页预览" aria-pressed="false">
            <File size={18} strokeWidth={1.7} />
          </button>
          <button type="button" data-viewer-mode="spread" aria-label="双页预览" title="双页预览" aria-pressed="false">
            <BookOpen size={18} strokeWidth={1.7} />
          </button>
        </div>

        <span class="lecture-viewer__control-divider" aria-hidden="true"></span>

        <output class="lecture-viewer__page-status" data-viewer-page-status aria-live="off">
          <span data-viewer-current>1</span>
          <span aria-hidden="true">/</span>
          <span data-viewer-total>--</span>
        </output>

        <span class="lecture-viewer__control-divider" aria-hidden="true"></span>

        <button type="button" data-viewer-zoom-out aria-label="缩小" title="缩小" disabled>
          <ZoomOut size={18} strokeWidth={1.7} />
        </button>
        <button type="button" data-viewer-zoom-in aria-label="放大" title="放大" disabled>
          <ZoomIn size={18} strokeWidth={1.7} />
        </button>
        <button type="button" data-viewer-fit-width aria-label="横向适配屏幕" title="横向适配屏幕" aria-pressed="true" disabled>
          <MoveHorizontal size={18} strokeWidth={1.7} />
        </button>
        <button type="button" data-viewer-fit-height aria-label="纵向适配屏幕" title="纵向适配屏幕" aria-pressed="false" disabled>
          <MoveVertical size={18} strokeWidth={1.7} />
        </button>
        <button type="button" data-viewer-fullscreen aria-label="全屏" title="全屏" aria-pressed="false">
          <Maximize2 size={18} strokeWidth={1.7} />
        </button>
      </div>

      <a
        class="lecture-viewer__download"
        href="/latex/"
        download
        aria-label="下载讲义"
        title="下载讲义"
        data-viewer-download
      >
        <Download size={18} strokeWidth={1.7} />
      </a>
      <a
        class="lecture-viewer__board"
        href="/latex/"
        aria-label="打开讲义留言板"
        title="留言板"
        data-viewer-board
        data-message-link
      >
        <MessageSquareText size={18} strokeWidth={1.7} />
        <span class="message-count-badge" data-message-count hidden></span>
      </a>
      <MusicPlayer />
    </header>

    <div class="lecture-viewer__mobile-safety" data-viewer-mobile-safety hidden>
      <a href="/latex/" aria-label="返回讲义目录" title="返回讲义目录">
        <ArrowLeft size={20} strokeWidth={1.7} />
      </a>
      <button type="button" data-viewer-chrome-show aria-label="显示阅读工具栏" title="显示工具栏">
        <PanelTopOpen size={20} strokeWidth={1.7} />
      </button>
    </div>

    <div class="lecture-viewer__body" data-viewer-body data-outline-open="false">
      <aside class="lecture-viewer__outline" data-viewer-outline hidden>
        <header>
          <p>Contents</p>
          <h2>目录</h2>
          <button class="lecture-viewer__outline-close" type="button" data-viewer-outline-close aria-label="关闭目录" title="关闭目录">
            <X size={20} strokeWidth={1.7} />
          </button>
        </header>
        <nav data-viewer-outline-list aria-label="讲义目录">
          <p class="lecture-viewer__outline-empty">正在读取目录</p>
        </nav>
      </aside>
      <button class="lecture-viewer__outline-scrim" type="button" data-viewer-outline-scrim aria-label="关闭目录" hidden></button>

      <div class="lecture-viewer__stage" data-viewer-stage>
        <div class="lecture-viewer__message" data-viewer-message>
          <span class="lecture-viewer__loading-mark" aria-hidden="true"></span>
          <p>正在载入讲义</p>
        </div>
        <div class="lecture-viewer__pages" data-viewer-pages data-mode="continuous"></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script is:inline>
  (() => {
    const allowedLecturePath = /^(?:\/lectures\/(?:maths|physics)|\/resources\/rynotes-v2)\/[^/]+\.pdf$/;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const state = {
      documentTask: null,
      pdfDocument: null,
      pdfUrl: "",
      progressKeyV1: "",
      progressKeyV2: "",
      mode: "continuous",
      fit: "width",
      zoom: 1,
      currentPage: 1,
      generation: 0,
      observer: null,
      renderTasks: new Set(),
      layoutRequest: 0,
      effectiveDpr: 1,
      dprMediaQuery: null,
      dprChangeHandler: null,
      stageResizeObserver: null,
      layoutTimer: 0,
      isFastScrolling: false,
      scrollStopTimer: 0,
      lastScrollTop: 0,
      lastScrollTime: 0,
      smoothedScrollVelocity: 0,
      scrollDirection: 1,
      renderQueue: [],
      activeRenderCount: 0,
      activeRequests: new Set(),
      renderRequestSerial: 0,
      renderPromises: new Map(),
      cleanupTimers: new Set(),
      pendingZoomTimer: 0,
      dprPollTimer: 0,
      eventHandlers: null,
      chromeVisible: true,
      isMobileViewport: false,
      mobileMediaQuery: null,
      mobileChangeHandler: null,
      tapCandidate: null,
      suppressTapUntil: 0,
      activePointers: new Set(),
      gesture: null,
      wheelAccumulator: 0,
      wheelDirection: 0,
      wheelLocked: false,
      wheelUnlockTimer: 0,
      isNavigating: false,
      navigationSerial: 0,
      isRestoring: false,
      suppressProgressSave: false,
      progressSaveTimer: 0,
      pageMetrics: new Map(),
      pageProxies: new Map(),
      lastStableAnchor: null,
      lastStageWidth: null,
      lastStageHeight: null,
      isFullscreen: false,
      pendingFullscreenAnchor: null,
      fullscreenEdgeGesture: null,
    };

    // Filled once the viewer DOM is resolved inside initialiseViewer(); module-level
    // functions (destroyDocument, setChromeVisible, progress helpers) only touch it
    // through optional chaining.
    let viewerElements = null;

    const MIN_ZOOM = 0.55;
    const MAX_ZOOM = 4;
    const SCROLL_SETTLE_MS = 150;
    const FAST_SCROLL_ENTER_VELOCITY = 0.8; // CSS px/ms
    const PREVIEW_OUTPUT_SCALE = 1;
    const MAX_EFFECTIVE_DPR = 4;
    const DEFAULT_RENDER_CONCURRENCY = 2;
    const LOW_MEMORY_RENDER_CONCURRENCY = 1;
    // Browsers silently fail on (or reject) canvases larger than a few thousand px
    // per side; never request a render canvas that exceeds this on either dimension.
    const MAX_CANVAS_SIDE = 16_384;
    const MOBILE_QUERY = "(max-width: 760px)";
    const TAP_MOVE_TOLERANCE = 10;
    const TAP_MAX_DURATION_MS = 450;
    const SWIPE_MIN_DISTANCE = 56;
    const SWIPE_WIDTH_RATIO = 0.12;
    const SWIPE_AXIS_RATIO = 1.25;
    const SWIPE_MAX_DURATION_MS = 700;
    const WHEEL_PAGE_THRESHOLD = 80;
    const WHEEL_BURST_SETTLE_MS = 220;
    const PROGRESS_SAVE_DEBOUNCE_MS = 250;
    const READING_LINE_RATIO = 0.35;
    const FULLSCREEN_EDGE_ZONE = 24;       // CSS px
    const FULLSCREEN_EXIT_MIN_DISTANCE = 72;
    const FULLSCREEN_EXIT_WIDTH_RATIO = 0.18;
    const FULLSCREEN_EXIT_AXIS_RATIO = 1.4;
    const FULLSCREEN_EXIT_MAX_DURATION_MS = 700;

    // Pixel budgets scale with device memory instead of the old 120Mpx single-page
    // allowance (≈480MB per canvas). Unknown memory is treated as the 8GB tier.
    // The page budget keeps a small headroom below the raw value because the
    // final canvas size is ceil()ed in both dimensions and may slightly exceed
    // the area implied by maxRenderScale.
    const memoryGigaBytes = Number(navigator.deviceMemory) || 8;
    const LOW_MEMORY_DEVICE = memoryGigaBytes <= 4;
    const maxPageRenderPixels = Math.floor((LOW_MEMORY_DEVICE ? 16_000_000 : 32_000_000) * 0.992);
    const maxActiveRenderPixels = LOW_MEMORY_DEVICE ? 32_000_000 : 64_000_000;
    const highRenderConcurrency = LOW_MEMORY_DEVICE
      ? LOW_MEMORY_RENDER_CONCURRENCY
      : DEFAULT_RENDER_CONCURRENCY;

    function clamp(value, min, max) {
      return Math.min(Math.max(value, min), max);
    }

    function clamp01(value) {
      return clamp(value, 0, 1);
    }

    function clampPage(page) {
      return Math.min(Math.max(Number(page) || 1, 1), state.pdfDocument?.numPages || 1);
    }

    function normalizePageForMode(page, mode) {
      const clamped = clampPage(page);
      if (mode !== "spread") return clamped;
      return clamped % 2 === 0 ? clamped - 1 : clamped;
    }

    function pageStep(mode) {
      return mode === "spread" ? 2 : 1;
    }

    function readEffectiveDpr() {
      const raw = Number(window.devicePixelRatio) || 1;
      return Math.min(Math.max(raw, 1), MAX_EFFECTIVE_DPR);
    }

    function clearCleanupTimers() {
      state.cleanupTimers.forEach((timer) => window.clearTimeout(timer));
      state.cleanupTimers.clear();
    }

    function scheduleOffscreenRelease(frame) {
      const existing = frame._cleanupTimer;
      if (existing) window.clearTimeout(existing);
      frame._cleanupTimer = window.setTimeout(() => {
        state.cleanupTimers.delete(frame._cleanupTimer);
        frame._cleanupTimer = null;
        unrenderFrame(frame);
      }, 1200);
      state.cleanupTimers.add(frame._cleanupTimer);
    }

    function frameIntersectsViewport(frame, margin = 0) {
      const top = frame.offsetTop;
      const bottom = top + frame.offsetHeight;
      const scrollTop = viewerElements.stage.scrollTop;
      const viewportBottom = scrollTop + viewerElements.stage.clientHeight;
      return bottom > scrollTop - margin && top < viewportBottom + margin;
    }

    // Total device pixels held by every live canvas, used to keep the active
    // bitmap pool inside maxActiveRenderPixels.
    function countActiveRenderPixels() {
      let total = 0;
      viewerElements.pages.querySelectorAll(".lecture-viewer__render-canvas, .lecture-viewer__transition-canvas").forEach((canvas) => {
        total += canvas.width * canvas.height;
      });
      return total;
    }

    function cancelRenders() {
      state.generation += 1;
      state.observer?.disconnect();
      state.observer = null;
      state.renderTasks.forEach((task) => task.cancel());
      state.renderTasks.clear();
      state.renderQueue = [];
      state.activeRequests.clear();
      state.activeRenderCount = 0;
      state.renderPromises.clear();
      clearCleanupTimers();
      viewerElements?.pages?.querySelectorAll("[data-page-number]").forEach((frame) => {
        // Stale keys belong to the superseded generation; clear them so the next
        // request for this frame always re-renders.
        delete frame.dataset.renderingKey;
        delete frame.dataset.renderedKey;
        delete frame.dataset.renderedQuality;
        frame._renderRequestId = 0;
        frame._cleanupTimer = null;
      });
    }

    function cancelQueuedRenders(predicate) {
      if (predicate) {
        state.renderQueue = state.renderQueue.filter((entry) => !predicate(entry));
      } else {
        state.renderQueue = [];
      }
    }

    // Release a frame's bitmaps and links. Never called during fast scrolling —
    // the previous frame must stay usable as a snapshot until the new one lands.
    function unrenderFrame(frame) {
      if (frame.dataset.near === "true" || state.isFastScrolling) return;
      if (frame._cleanupTimer) {
        window.clearTimeout(frame._cleanupTimer);
        state.cleanupTimers.delete(frame._cleanupTimer);
        frame._cleanupTimer = null;
      }
      frame._renderTask?.cancel();
      frame._renderTask = null;
      frame._renderRequestId = 0;
      cancelQueuedRenders((entry) => entry.frame === frame);
      frame.querySelectorAll(".lecture-viewer__render-canvas, .lecture-viewer__transition-canvas").forEach((canvas) => {
        canvas.width = 1;
        canvas.height = 1;
        canvas.hidden = true;
      });
      const links = frame.querySelector(".lecture-viewer__link-layer");
      const placeholder = frame.querySelector(".lecture-viewer__page-placeholder");
      links.replaceChildren();
      placeholder.hidden = false;
      delete frame.dataset.renderedKey;
      delete frame.dataset.renderingKey;
      delete frame.dataset.renderedQuality;
    }

    function frameForPage(pageNumber) {
      return viewerElements?.pages?.querySelector(`[data-page-number="${pageNumber}"]`) ?? null;
    }

    // The page that currently covers the 35% reading line. In continuous mode the
    // page number and the progress anchor both come from here, not from an
    // observer entry — the observer only decides which frames are near.
    function chooseFrameAtReadingLine() {
      const pages = viewerElements?.pages;
      if (!pages) return null;
      const frames = [...pages.querySelectorAll("[data-page-number]")];
      if (!frames.length) return null;
      const stage = viewerElements.stage;
      const line = stage.scrollTop + stage.clientHeight * READING_LINE_RATIO;
      let best = frames.find((frame) => {
        const top = frame.offsetTop;
        return line >= top && line < top + frame.offsetHeight;
      });
      if (best) return best;
      // A page gap covers the line; pick the page whose centre is closest.
      return frames.reduce((closest, frame) => {
        const centre = frame.offsetTop + frame.offsetHeight / 2;
        const currentCentre = closest.offsetTop + closest.offsetHeight / 2;
        return Math.abs(centre - line) < Math.abs(currentCentre - line) ? frame : closest;
      }, frames[0]);
    }

    function forceLayoutRead() {
      void viewerElements?.stage?.offsetHeight;
    }

    // ---------- Chrome visibility ----------

    function setChromeVisible(visible, { focus = false, reason = "user" } = {}) {
      void reason; // descriptive for call sites; not needed by the state machine
      if (state.isFullscreen) visible = false;
      else if (!state.isMobileViewport) visible = true;
      state.chromeVisible = Boolean(visible);
      const viewer = viewerElements?.viewer;
      if (!viewer) return;
      viewer.dataset.chromeVisible = String(state.chromeVisible);
      if (viewerElements.mobileSafety) {
        viewerElements.mobileSafety.hidden = state.chromeVisible || !state.isMobileViewport;
      }
      if (viewerElements.toolbar) {
        viewerElements.toolbar.toggleAttribute("inert", !state.chromeVisible && state.isMobileViewport);
        viewerElements.toolbar.setAttribute("aria-hidden", String(!state.chromeVisible && state.isMobileViewport));
      }
      if (focus && state.chromeVisible && viewerElements.outlineToggle) {
        viewerElements.outlineToggle.focus({ preventScroll: true });
      }
    }

    // Any path that starts on a control, a PDF link, the toolbar, the safety
    // entry, the outline, or a floating panel must never toggle the chrome.
    function isInteractivePath(path) {
      for (const node of path) {
        if (!(node instanceof Element)) continue;
        if (node.closest("a, button, input, summary, details")) return true;
        if (node.closest(".lecture-viewer__toolbar, .lecture-viewer__mobile-safety, .lecture-viewer__outline, .lecture-viewer__outline-scrim")) return true;
        if (node.closest(".music-panel, .music-player")) return true;
        if (node.closest(".lecture-viewer__pdf-link")) return true;
        if (node.closest("[data-no-chrome-toggle]")) return true;
      }
      return false;
    }

    function cancelTapCandidate() {
      state.tapCandidate = null;
    }

    function cancelPointerGesture() {
      state.gesture = null;
    }

    function resetPagedWheelGesture() {
      state.wheelAccumulator = 0;
      state.wheelDirection = 0;
      state.wheelLocked = false;
      window.clearTimeout(state.wheelUnlockTimer);
      state.wheelUnlockTimer = 0;
    }

    // ---------- Layout state attributes ----------

    function setLayoutState(layoutState) {
      if (viewerElements?.viewer) viewerElements.viewer.dataset.layoutState = layoutState;
    }

    function setNavigationState(navigationState) {
      if (viewerElements?.viewer) viewerElements.viewer.dataset.navigationState = navigationState;
    }

    // ---------- Progress (v2) and reading anchors ----------

    function readLocalStorage(key) {
      try {
        return window.localStorage.getItem(key);
      } catch {
        return null;
      }
    }

    function parseProgressV2(raw) {
      if (!raw) return null;
      let data;
      try {
        data = JSON.parse(raw);
      } catch {
        return null;
      }
      if (!data || typeof data !== "object") return null;
      const mode = ["continuous", "single", "spread"].includes(data.mode) ? data.mode : "continuous";
      const page = clampPage(data.page);
      const fit = ["width", "height"].includes(data.fit) ? data.fit : "width";
      const zoom = clamp(Number(data.zoom) || 1, MIN_ZOOM, MAX_ZOOM);
      const pdfX = Number.isFinite(Number(data.pdfX)) ? Number(data.pdfX) : null;
      const pdfY = Number.isFinite(Number(data.pdfY)) ? Number(data.pdfY) : null;
      const viewportXRatio = clamp01(Number(data.viewportXRatio) || 0.5);
      const viewportYRatio = clamp01(Number(data.viewportYRatio) || READING_LINE_RATIO);
      return {
        version: 2,
        mode,
        page,
        pdfX,
        pdfY,
        viewportXRatio,
        viewportYRatio,
        zoom,
        fit,
        updatedAt: Number(data.updatedAt) || Date.now(),
      };
    }

    function defaultProgress() {
      return {
        version: 2,
        mode: "continuous",
        page: 1,
        pdfX: null,
        pdfY: null,
        viewportXRatio: 0.5,
        viewportYRatio: READING_LINE_RATIO,
        zoom: 1,
        fit: "width",
        updatedAt: 0,
      };
    }

    function loadProgressV2OrMigrateV1() {
      const v2 = parseProgressV2(readLocalStorage(state.progressKeyV2));
      if (v2) return v2;
      const v1 = readLocalStorage(state.progressKeyV1);
      if (v1) {
        const page = clampPage(Number(v1) || 1);
        return {
          version: 2,
          mode: "continuous",
          page,
          pdfX: null,
          pdfY: null,
          viewportXRatio: 0.5,
          viewportYRatio: READING_LINE_RATIO,
          zoom: 1,
          fit: "width",
          updatedAt: 0,
        };
      }
      return defaultProgress();
    }

    function captureReadingAnchor() {
      if (!state.pdfDocument) return null;
      if (state.mode === "continuous") {
        const frame = chooseFrameAtReadingLine();
        if (!frame?._viewport) return fallbackAnchorFromCurrentPage();
        const surface = frame.querySelector(".lecture-viewer__page-surface");
        if (!surface) return fallbackAnchorFromCurrentPage();
        const stage = viewerElements.stage;
        const stageRect = stage.getBoundingClientRect();
        const surfaceRect = surface.getBoundingClientRect();
        const stageCenterX = stageRect.left + stage.clientWidth / 2;
        const readingLineY = stageRect.top + stage.clientHeight * READING_LINE_RATIO;
        const localX = clamp01((stageCenterX - surfaceRect.left) / surfaceRect.width) * surfaceRect.width;
        const localY = clamp01((readingLineY - surfaceRect.top) / surfaceRect.height) * surfaceRect.height;
        const [pdfX, pdfY] = frame._viewport.convertToPdfPoint(localX, localY);
        return {
          page: Number(frame.dataset.pageNumber),
          pdfX,
          pdfY,
          viewportXRatio: 0.5,
          viewportYRatio: READING_LINE_RATIO,
        };
      }
      // Paged mode: the current page (or the first page of the pair). At zoom 1
      // there is no meaningful in-page point, so fall back to the page centre.
      const page = normalizePageForMode(state.currentPage, state.mode);
      const frame = frameForPage(page);
      if (frame?._viewport && state.zoom > 1) {
        const surface = frame.querySelector(".lecture-viewer__page-surface");
        if (surface) {
          const stage = viewerElements.stage;
          const stageRect = stage.getBoundingClientRect();
          const surfaceRect = surface.getBoundingClientRect();
          const centreX = stageRect.left + stage.clientWidth / 2;
          const centreY = stageRect.top + stage.clientHeight / 2;
          const localX = clamp01((centreX - surfaceRect.left) / surfaceRect.width) * surfaceRect.width;
          const localY = clamp01((centreY - surfaceRect.top) / surfaceRect.height) * surfaceRect.height;
          const [pdfX, pdfY] = frame._viewport.convertToPdfPoint(localX, localY);
          return { page, pdfX, pdfY, viewportXRatio: 0.5, viewportYRatio: 0.5 };
        }
      }
      return fallbackAnchorFromCurrentPage();
    }

    function fallbackAnchorFromCurrentPage() {
      return {
        page: normalizePageForMode(state.currentPage, state.mode),
        pdfX: null,
        pdfY: null,
        viewportXRatio: 0.5,
        viewportYRatio: state.mode === "continuous" ? READING_LINE_RATIO : 0.5,
      };
    }

    // Direct scrollTop/scrollLeft assignment (no scrollIntoView, no smooth).
    function restoreContinuousAnchor(anchor) {
      const stage = viewerElements.stage;
      const frame = frameForPage(anchor.page);
      if (!frame) return;
      if (Number.isFinite(anchor.pdfX) && Number.isFinite(anchor.pdfY) && frame._viewport) {
        const [cssX, cssY] = frame._viewport.convertToViewportPoint(anchor.pdfX, anchor.pdfY);
        const targetLeft = frame.offsetLeft + cssX - stage.clientWidth * 0.5;
        const targetTop = frame.offsetTop + cssY - stage.clientHeight * READING_LINE_RATIO;
        stage.scrollLeft = clamp(targetLeft, 0, Math.max(0, stage.scrollWidth - stage.clientWidth));
        stage.scrollTop = clamp(targetTop, 0, Math.max(0, stage.scrollHeight - stage.clientHeight));
      } else {
        stage.scrollTop = clamp(frame.offsetTop - 16, 0, Math.max(0, stage.scrollHeight - stage.clientHeight));
        stage.scrollLeft = 0;
      }
    }

    function centerPagedLayer() {
      const pages = viewerElements.pages;
      const layer = pages.querySelector(".lecture-viewer__paged-layer--current");
      if (!layer) return;
      // The layer is inset:0, so its scrollWidth/scrollHeight reflect the real
      // content extent (the centred frames) instead of the box itself.
      pages.scrollLeft = Math.max(0, (layer.scrollWidth - pages.clientWidth) / 2);
      pages.scrollTop = Math.max(0, (layer.scrollHeight - pages.clientHeight) / 2);
    }

    function restorePagedAnchor(anchor) {
      centerPagedLayer();
      if (!anchor || !Number.isFinite(anchor.pdfX) || !Number.isFinite(anchor.pdfY)) return;
      const frame = frameForPage(anchor.page);
      if (!frame?._viewport) return;
      const pages = viewerElements.pages;
      const [cssX, cssY] = frame._viewport.convertToViewportPoint(anchor.pdfX, anchor.pdfY);
      const frameRect = frame.getBoundingClientRect();
      const pagesRect = pages.getBoundingClientRect();
      const frameLeftInPages = frameRect.left - pagesRect.left + pages.scrollLeft;
      const frameTopInPages = frameRect.top - pagesRect.top + pages.scrollTop;
      const targetLeft = frameLeftInPages + cssX - pages.clientWidth * (anchor.viewportXRatio ?? 0.5);
      const targetTop = frameTopInPages + cssY - pages.clientHeight * (anchor.viewportYRatio ?? 0.5);
      pages.scrollLeft = clamp(targetLeft, 0, Math.max(0, pages.scrollWidth - pages.clientWidth));
      pages.scrollTop = clamp(targetTop, 0, Math.max(0, pages.scrollHeight - pages.clientHeight));
    }

    function restoreReadingAnchor(anchor) {
      if (!anchor) return;
      if (state.mode === "continuous") restoreContinuousAnchor(anchor);
      else restorePagedAnchor(anchor);
    }

    function saveProgressV2() {
      if (state.suppressProgressSave || !state.pdfDocument) return;
      const anchor = captureReadingAnchor() ?? fallbackAnchorFromCurrentPage();
      const payload = {
        version: 2,
        mode: state.mode,
        page: anchor.page,
        pdfX: anchor.pdfX,
        pdfY: anchor.pdfY,
        viewportXRatio: anchor.viewportXRatio,
        viewportYRatio: anchor.viewportYRatio,
        zoom: state.zoom,
        fit: state.fit,
        updatedAt: Date.now(),
      };
      try {
        window.localStorage.setItem(state.progressKeyV2, JSON.stringify(payload));
      } catch {
        // Reading remains available when browser storage is disabled.
      }
    }

    function scheduleProgressSave() {
      if (state.suppressProgressSave) return;
      window.clearTimeout(state.progressSaveTimer);
      state.progressSaveTimer = window.setTimeout(() => {
        state.progressSaveTimer = 0;
        saveProgressV2();
      }, PROGRESS_SAVE_DEBOUNCE_MS);
    }

    function flushProgressSave() {
      window.clearTimeout(state.progressSaveTimer);
      state.progressSaveTimer = 0;
      saveProgressV2();
    }

    // ---------- Page metrics ----------

    async function mapWithConcurrency(items, concurrency, fn) {
      let index = 0;
      await Promise.all(Array.from({ length: concurrency }, async () => {
        while (index < items.length) {
          const item = items[index];
          index += 1;
          await fn(item);
        }
      }));
    }

    // Reads only the base viewport of every page (no canvas render) so frames can
    // carry their own CSS dimensions and the reading anchor stays stable. PageProxy
    // handles are cached for synchronous viewport re-derivation during layout.
    async function loadPageMetrics(pdfDocument) {
      const metrics = new Map();
      const proxies = new Map();
      const generation = state.generation;
      await mapWithConcurrency(Array.from({ length: pdfDocument.numPages }, (_, i) => i + 1), 8, async (pageNumber) => {
        if (generation !== state.generation || state.pdfDocument !== pdfDocument) return;
        const page = await pdfDocument.getPage(pageNumber);
        if (generation !== state.generation || state.pdfDocument !== pdfDocument) return;
        const viewport = page.getViewport({ scale: 1 });
        metrics.set(pageNumber, {
          width: viewport.width,
          height: viewport.height,
          rotation: viewport.rotation,
        });
        proxies.set(pageNumber, page);
      });
      return { metrics, proxies };
    }

    function nextAnimationFrame() {
      return new Promise((resolve) => window.requestAnimationFrame(() => resolve()));
    }

    async function destroyDocument() {
      flushProgressSave();
      state.navigationSerial += 1;
      state.isNavigating = false;
      state.gesture = null;
      state.tapCandidate = null;
      state.fullscreenEdgeGesture = null;
      state.activePointers.clear();
      cancelRenders();
      if (state.mobileMediaQuery && state.mobileChangeHandler) {
        state.mobileMediaQuery.removeEventListener("change", state.mobileChangeHandler);
        state.mobileMediaQuery = null;
        state.mobileChangeHandler = null;
      }
      if (state.dprMediaQuery && state.dprChangeHandler) {
        state.dprMediaQuery.removeEventListener("change", state.dprChangeHandler);
        state.dprMediaQuery = null;
        state.dprChangeHandler = null;
      }
      state.stageResizeObserver?.disconnect();
      state.stageResizeObserver = null;
      const handlers = state.eventHandlers;
      if (handlers) {
        window.removeEventListener("resize", handlers.onWindowResize);
        window.visualViewport?.removeEventListener("resize", handlers.onVisualViewportResize);
        document.removeEventListener("fullscreenchange", handlers.onFullscreenChange);
        document.removeEventListener("visibilitychange", handlers.onVisibilityChange);
        document.removeEventListener("keydown", handlers.onDocumentKeydown);
        if (handlers.onFullscreenEscapeCapture) document.removeEventListener("keydown", handlers.onFullscreenEscapeCapture, true);
        window.removeEventListener("pagehide", handlers.onPageHide);
        viewerElements?.stage?.removeEventListener("scroll", handlers.onStageScroll, { passive: true });
        viewerElements?.stage?.removeEventListener("wheel", handlers.onStageWheel, { passive: false });
        viewerElements?.stage?.removeEventListener("pointerdown", handlers.onStagePointerDown);
        viewerElements?.stage?.removeEventListener("pointermove", handlers.onStagePointerMove);
        viewerElements?.stage?.removeEventListener("pointerup", handlers.onStagePointerUp);
        viewerElements?.stage?.removeEventListener("pointercancel", handlers.onStagePointerCancel);
        state.eventHandlers = null;
      }
      window.clearTimeout(state.layoutTimer);
      window.clearTimeout(state.scrollStopTimer);
      window.clearTimeout(state.pendingZoomTimer);
      window.clearTimeout(state.progressSaveTimer);
      window.clearTimeout(state.wheelUnlockTimer);
      window.clearInterval(state.dprPollTimer);
      clearCleanupTimers();
      viewerElements?.pages?.querySelectorAll(".lecture-viewer__render-canvas, .lecture-viewer__transition-canvas").forEach((canvas) => {
        canvas.width = 1;
        canvas.height = 1;
      });
      await state.pdfDocument?.destroy();
      state.pdfDocument = null;
      state.pageMetrics = new Map();
      state.pageProxies = new Map();
      await state.documentTask?.destroy();
      state.documentTask = null;
    }

    async function initialiseViewer() {
      const viewer = document.querySelector("[data-lecture-viewer]");
      if (!viewer || viewer.dataset.initialised === "true") return;
      viewer.dataset.initialised = "true";

      const elements = {
        viewer,
        toolbar: viewer.querySelector(".lecture-viewer__toolbar"),
        body: viewer.querySelector("[data-viewer-body]"),
        stage: viewer.querySelector("[data-viewer-stage]"),
        pages: viewer.querySelector("[data-viewer-pages]"),
        message: viewer.querySelector("[data-viewer-message]"),
        title: viewer.querySelector("#viewer-title"),
        download: viewer.querySelector("[data-viewer-download]"),
        board: viewer.querySelector("[data-viewer-board]"),
        outline: viewer.querySelector("[data-viewer-outline]"),
        outlineList: viewer.querySelector("[data-viewer-outline-list]"),
        outlineToggle: viewer.querySelector("[data-viewer-outline-toggle]"),
        outlineClose: viewer.querySelector("[data-viewer-outline-close]"),
        outlineScrim: viewer.querySelector("[data-viewer-outline-scrim]"),
        mobileSafety: viewer.querySelector("[data-viewer-mobile-safety]"),
        chromeShow: viewer.querySelector("[data-viewer-chrome-show]"),
        current: viewer.querySelector("[data-viewer-current]"),
        total: viewer.querySelector("[data-viewer-total]"),
        zoomOut: viewer.querySelector("[data-viewer-zoom-out]"),
        zoomIn: viewer.querySelector("[data-viewer-zoom-in]"),
        fitWidth: viewer.querySelector("[data-viewer-fit-width]"),
        fitHeight: viewer.querySelector("[data-viewer-fit-height]"),
        fullscreen: viewer.querySelector("[data-viewer-fullscreen]"),
        modeButtons: [...viewer.querySelectorAll("[data-viewer-mode]")],
      };

      if (Object.values(elements).some((value) => value == null)) return;
      viewerElements = elements;

      const params = new URLSearchParams(window.location.search);
      const requestedFile = params.get("file");
      const requestedTitle = params.get("title") || "讲义阅读";
      let pdfUrl;

      try {
        const candidate = new URL(requestedFile || "", window.location.origin);
        if (candidate.origin !== window.location.origin || !allowedLecturePath.test(candidate.pathname)) {
          throw new Error("请从讲义目录选择需要阅读的讲义。");
        }
        pdfUrl = `${candidate.pathname}${candidate.search}`;
      } catch (error) {
        showError(error.message || "讲义链接无效。");
        return;
      }

      elements.title.textContent = requestedTitle;
      document.title = `${requestedTitle} | RongYu's Notes`;
      elements.download.href = pdfUrl;
      elements.download.download = decodeURIComponent(pdfUrl.split("/").pop() || "lecture.pdf");
      const messageSlug = elements.download.download.replace(/\.pdf$/i, "").toLocaleLowerCase();
      elements.board.href = `/messages/${messageSlug}/`;
      elements.board.dataset.messageSlug = messageSlug;
      elements.board.setAttribute("aria-label", `打开《${requestedTitle}》留言板`);
      document.dispatchEvent(new CustomEvent("lecture-message-ready"));

      state.pdfUrl = pdfUrl;
      state.progressKeyV1 = `rongyu-notes.reader-progress.v1:${pdfUrl}`;
      state.progressKeyV2 = `rongyu-notes.reader-progress.v2:${pdfUrl}`;

      // Mobile breakpoint — never navigator.userAgent.
      state.mobileMediaQuery = window.matchMedia(MOBILE_QUERY);
      state.isMobileViewport = state.mobileMediaQuery.matches;
      state.mobileChangeHandler = () => {
        state.isMobileViewport = state.mobileMediaQuery.matches;
        setChromeVisible(state.chromeVisible, { reason: "breakpoint" });
      };
      state.mobileMediaQuery.addEventListener("change", state.mobileChangeHandler);
      setChromeVisible(true, { reason: "init" });

      const pdfjs = window.pdfjsLib;
      if (!pdfjs?.getDocument) {
        showError("阅读器资源未能载入，请刷新页面后重试。");
        return;
      }
      pdfjs.GlobalWorkerOptions.workerSrc = "https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js";

      function showError(text) {
        elements.title.textContent = "无法打开讲义";
        elements.message.hidden = false;
        elements.message.innerHTML = '<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 8v5m0 4h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg><p></p>';
        elements.message.querySelector("p").textContent = text;
      }

      function updateControls() {
        const ready = Boolean(state.pdfDocument);
        const total = state.pdfDocument?.numPages || 1;
        elements.current.textContent = ready ? String(state.currentPage) : "1";
        elements.total.textContent = ready ? String(total) : "--";
        elements.zoomOut.disabled = !ready || state.zoom <= MIN_ZOOM;
        elements.zoomIn.disabled = !ready || state.zoom >= MAX_ZOOM;
        elements.fitWidth.disabled = !ready;
        elements.fitHeight.disabled = !ready;
        elements.fitWidth.setAttribute("aria-pressed", String(state.fit === "width"));
        elements.fitHeight.setAttribute("aria-pressed", String(state.fit === "height"));
        elements.modeButtons.forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.viewerMode === state.mode));
        });
      }

      // CSS scale for a page, derived from its own cached base viewport. Spread
      // pairs derive the scale from the first (odd) page so both pages agree.
      function displayScaleForPage(pageNumber, pagesInRow = 1) {
        const source = pagesInRow === 2 ? normalizePageForMode(pageNumber, "spread") : pageNumber;
        const metric = state.pageMetrics.get(source) ?? state.pageMetrics.get(pageNumber);
        if (!metric) return 1;
        const horizontalPadding = state.mode === "continuous" ? 52 : 64;
        const availableWidth = Math.max(260, elements.stage.clientWidth - horizontalPadding);
        const availableHeight = Math.max(260, elements.stage.clientHeight - 48);
        const widthPerPage = pagesInRow === 2 ? (availableWidth - 22) / 2 : availableWidth;
        const fitted = state.fit === "height" ? availableHeight / metric.height : widthPerPage / metric.width;
        return Math.max(fitted * state.zoom, 0.25);
      }

      function cssDimensionsForPage(pageNumber, pagesInRow = 1) {
        const metric = state.pageMetrics.get(pageNumber);
        if (!metric) return { width: 1, height: 1 };
        const scale = displayScaleForPage(pageNumber, pagesInRow);
        return {
          width: Math.max(1, Math.ceil(metric.width * scale)),
          height: Math.max(1, Math.ceil(metric.height * scale)),
        };
      }

      function viewportForFrame(pageNumber, scale) {
        const proxy = state.pageProxies.get(pageNumber);
        return proxy ? proxy.getViewport({ scale }) : null;
      }

      function createPageFrame(pageNumber, dimensions) {
        const frame = document.createElement("article");
        frame.className = "lecture-viewer__page";
        frame.dataset.pageNumber = String(pageNumber);
        frame.setAttribute("aria-label", `第 ${pageNumber} 页`);

        const surface = document.createElement("div");
        surface.className = "lecture-viewer__page-surface";
        surface.style.width = `${dimensions.width}px`;
        surface.style.height = `${dimensions.height}px`;

        const canvas = document.createElement("canvas");
        canvas.className = "lecture-viewer__render-canvas";
        canvas.hidden = true;
        const links = document.createElement("div");
        links.className = "lecture-viewer__link-layer";
        const placeholder = document.createElement("span");
        placeholder.className = "lecture-viewer__page-placeholder";
        placeholder.textContent = String(pageNumber);

        surface.append(canvas, links, placeholder);
        frame.append(surface);
        return frame;
      }

      // Best-effort pool relief before allocating a new high canvas, in the
      // plan's order: (1) any bitmap that already left the near zone, farthest
      // first; (2) preview bitmaps that are farthest from the viewport centre.
      function releaseDistantFrames(neededPixels) {
        const scrollTop = elements.stage.scrollTop;
        const center = scrollTop + elements.stage.clientHeight / 2;
        const frames = [...elements.pages.querySelectorAll("[data-page-number]")];
        const hasLiveCanvas = (frame) => {
          const canvas = frame.querySelector(".lecture-viewer__render-canvas, .lecture-viewer__transition-canvas");
          return Boolean(canvas && canvas.width > 1 && !canvas.hidden);
        };
        const byDistanceDesc = (a, b) => {
          const aCenter = a.offsetTop + a.offsetHeight / 2;
          const bCenter = b.offsetTop + b.offsetHeight / 2;
          return Math.abs(bCenter - center) - Math.abs(aCenter - center);
        };
        const releaseCanvas = (frame) => {
          const canvas = frame.querySelector(".lecture-viewer__render-canvas, .lecture-viewer__transition-canvas");
          if (!canvas) return;
          canvas.width = 1;
          canvas.height = 1;
          canvas.hidden = true;
          const placeholder = frame.querySelector(".lecture-viewer__page-placeholder");
          placeholder.hidden = false;
          delete frame.dataset.renderedKey;
          delete frame.dataset.renderedQuality;
        };
        const enough = () => countActiveRenderPixels() <= maxActiveRenderPixels - neededPixels;

        // Pass 1: frames that left the near zone (any quality), farthest first.
        const leftNear = frames
          .filter((frame) => frame.dataset.near !== "true" && hasLiveCanvas(frame))
          .sort(byDistanceDesc);
        for (const frame of leftNear) {
          releaseCanvas(frame);
          if (enough()) return;
        }
        // Pass 2: farthest preview bitmaps, even if still near the viewport.
        const previews = frames
          .filter((frame) => frame.dataset.renderedQuality === "preview" && hasLiveCanvas(frame))
          .sort(byDistanceDesc);
        for (const frame of previews) {
          releaseCanvas(frame);
          if (enough()) return;
        }
      }

      function requestRenderSerial() {
        state.renderRequestSerial += 1;
        return state.renderRequestSerial;
      }

      function renderAnnotations(frame, page, displayViewport, generation) {
        return page.getAnnotations({ intent: "display" }).then((annotations) => {
          if (generation !== state.generation) return;
          const links = frame.querySelector(".lecture-viewer__link-layer");
          links.replaceChildren();
          annotations.filter((annotation) => annotation.subtype === "Link").forEach((annotation) => {
            const rect = displayViewport.convertToViewportRectangle(annotation.rect);
            const link = document.createElement("a");
            link.className = "lecture-viewer__pdf-link";
            link.style.left = `${Math.min(rect[0], rect[2])}px`;
            link.style.top = `${Math.min(rect[1], rect[3])}px`;
            link.style.width = `${Math.max(Math.abs(rect[2] - rect[0]), 3)}px`;
            link.style.height = `${Math.max(Math.abs(rect[3] - rect[1]), 3)}px`;
            link.setAttribute("aria-label", "PDF 链接");

            if (annotation.url || annotation.unsafeUrl) {
              link.href = annotation.url || annotation.unsafeUrl;
              link.target = "_blank";
              link.rel = "noreferrer";
            } else if (annotation.dest) {
              link.href = "#";
              link.addEventListener("click", (event) => {
                event.preventDefault();
                navigateToDestination(annotation.dest);
              });
            } else if (annotation.action) {
              link.href = "#";
              link.addEventListener("click", (event) => {
                event.preventDefault();
                runNamedAction(annotation.action);
              });
            } else {
              return;
            }
            links.append(link);
          });
        });
      }

      async function renderFrame(request) {
        const frame = request.frame;
        const pageNumber = Number(frame.dataset.pageNumber);
        const generation = request.generation;
        const page = await state.pdfDocument.getPage(pageNumber);
        const pagesInRow = state.mode === "spread" ? 2 : 1;
        const displayScale = displayScaleForPage(pageNumber, pagesInRow);
        if (generation !== state.generation) return false;
        const displayViewport = page.getViewport({ scale: displayScale });
        const cssWidth = Math.ceil(displayViewport.width);
        const cssHeight = Math.ceil(displayViewport.height);
        const requestedOutputScale = request.quality === "high"
          ? state.effectiveDpr
          : Math.min(PREVIEW_OUTPUT_SCALE, state.effectiveDpr);
        const requestedRenderScale = displayScale * requestedOutputScale;
        const base = page.getViewport({ scale: 1 });
        const maxRenderScale = Math.min(
          Math.sqrt(maxPageRenderPixels / (base.width * base.height)),
          MAX_CANVAS_SIDE / Math.max(base.width, base.height),
        );
        const renderScale = Math.min(requestedRenderScale, maxRenderScale);
        let effectiveRenderScale = renderScale;
        let renderViewport = page.getViewport({ scale: renderScale });
        let canvasWidth = Math.max(1, Math.ceil(renderViewport.width));
        let canvasHeight = Math.max(1, Math.ceil(renderViewport.height));
        const targetPixels = canvasWidth * canvasHeight;
        // Keep the whole active pool inside maxActiveRenderPixels: release the
        // frames that left the near zone and the farthest previews first; if the
        // pool is still short, reduce this page's own scale so the total budget
        // is never exceeded.
        if (request.quality === "high") {
          releaseDistantFrames(targetPixels);
          if (countActiveRenderPixels() + targetPixels > maxActiveRenderPixels) {
            const available = Math.max(1, maxActiveRenderPixels - countActiveRenderPixels());
            const budgetScale = Math.sqrt(available / (base.width * base.height));
            effectiveRenderScale = Math.min(effectiveRenderScale, budgetScale);
            renderViewport = page.getViewport({ scale: effectiveRenderScale });
            canvasWidth = Math.max(1, Math.ceil(renderViewport.width));
            canvasHeight = Math.max(1, Math.ceil(renderViewport.height));
          }
        }
        const renderedKey = `${generation}|${pageNumber}|${request.quality}|${cssWidth}|${cssHeight}|${effectiveRenderScale.toFixed(4)}|${state.effectiveDpr.toFixed(4)}`;
        const currentQuality = frame.dataset.renderedQuality;
        const alreadyRendered = frame.dataset.renderedKey === renderedKey
          || (currentQuality === "high" && request.quality === "preview");
        if (alreadyRendered) return false;
        if (frame.dataset.renderingKey === renderedKey) return false;
        frame._renderTask?.cancel();
        frame._renderTask = null;
        frame.dataset.renderingKey = renderedKey;

        const surface = frame.querySelector(".lecture-viewer__page-surface");
        const links = frame.querySelector(".lecture-viewer__link-layer");
        const placeholder = frame.querySelector(".lecture-viewer__page-placeholder");

        // Keep the previous bitmap visible, stretched to the new size, while the
        // fresh resolution rasterizes on top — this is what makes zoom feel like
        // a native reader instead of flashing back to a placeholder.
        let transitionCanvas = frame.querySelector(".lecture-viewer__transition-canvas");
        const shown = frame.querySelector(".lecture-viewer__render-canvas");
        if (!transitionCanvas && shown && !shown.hidden && shown.width > 1) {
          shown.classList.remove("lecture-viewer__render-canvas");
          shown.classList.add("lecture-viewer__transition-canvas");
          transitionCanvas = shown;
        }
        if (transitionCanvas) {
          transitionCanvas.style.width = `${cssWidth}px`;
          transitionCanvas.style.height = `${cssHeight}px`;
        }
        // Drop stale hidden layers so the surface never accumulates canvases.
        frame.querySelectorAll(".lecture-viewer__render-canvas").forEach((stale) => stale.remove());

        const canvas = document.createElement("canvas");
        canvas.className = "lecture-viewer__render-canvas";
        canvas.hidden = true;
        canvas.width = canvasWidth;
        canvas.height = canvasHeight;
        canvas.style.width = `${cssWidth}px`;
        canvas.style.height = `${cssHeight}px`;
        const context = canvas.getContext("2d", { alpha: false });
        if (!context || generation !== state.generation) return false;

        surface.style.width = `${cssWidth}px`;
        surface.style.height = `${cssHeight}px`;
        links.style.width = `${cssWidth}px`;
        links.style.height = `${cssHeight}px`;
        frame._viewport = displayViewport;
        surface.insertBefore(canvas, links);

        const task = page.render({ canvasContext: context, viewport: renderViewport });
        frame._renderTask = task;
        state.renderTasks.add(task);
        try {
          await task.promise;
        } catch (error) {
          // Cancellation is normal control flow when a newer request supersedes
          // this one; anything else propagates to the queue's catch handler.
          if (error?.name !== "RenderingCancelledException") throw error;
        } finally {
          state.renderTasks.delete(task);
          frame._renderTask = null;
        }
        if (generation !== state.generation || request.requestId !== frame._renderRequestId) {
          canvas.remove();
          return false;
        }

        transitionCanvas?.remove();
        placeholder.hidden = true;
        canvas.hidden = false;
        frame.dataset.renderedKey = renderedKey;
        frame.dataset.renderedQuality = request.quality;
        delete frame.dataset.renderingKey;
        if (request.quality === "high") {
          await renderAnnotations(frame, page, displayViewport, generation);
        }
        return true;
      }

      function enqueueRender(frame, { quality = "high", priority = 100, reason = "view" } = {}) {
        const pageNumber = Number(frame.dataset.pageNumber);
        const currentQuality = frame.dataset.renderedQuality;
        // A high bitmap (or a high render already in flight) already covers this
        // page — preview must never cancel or downgrade it.
        if (currentQuality === "high" && quality === "preview") return 0;
        if (quality === "preview" && frame._renderTask && frame.dataset.renderingKey?.includes("|high|")) return 0;
        cancelFrameRender(frame);
        const requestId = requestRenderSerial();
        frame._renderRequestId = requestId;
        const entry = {
          frame,
          pageNumber,
          quality,
          priority,
          reason,
          generation: state.generation,
          requestId,
        };
        state.renderQueue.push(entry);
        state.renderQueue.sort((a, b) => a.priority - b.priority || a.requestId - b.requestId);
        pumpRenderQueue();
        return requestId;
      }

      function pumpRenderQueue() {
        // Drop stale entries first, then start as many runnable entries as the
        // concurrency budget allows.
        state.renderQueue = state.renderQueue.filter((entry) => entry.generation === state.generation);
        while (state.renderQueue.length > 0) {
          const entry = state.renderQueue[0];
          if (state.isFastScrolling && entry.quality === "high") return;
          if (entry.quality === "preview" && entry.frame.dataset.renderedQuality === "high") {
            state.renderQueue.shift();
            continue;
          }
          const concurrency = entry.quality === "preview"
            ? 1
            : highRenderConcurrency;
          if (state.activeRequests.size >= concurrency) return;
          state.renderQueue.shift();
          state.activeRequests.add(entry.requestId);
          state.activeRenderCount = state.activeRequests.size;
          state.renderPromises.set(entry.requestId, true);
          renderFrame(entry).catch((error) => {
            if (error?.name !== "RenderingCancelledException") {
              // Keep the previous canvas or placeholder; a failed refresh must
              // never leave an unhandled rejection or a blank page.
              console.warn("lecture render failed", entry.reason, error);
            }
          }).finally(() => {
            state.activeRequests.delete(entry.requestId);
            state.activeRenderCount = state.activeRequests.size;
            state.renderPromises.delete(entry.requestId);
            pumpRenderQueue();
          });
        }
      }

      function cancelFrameRender(frame) {
        frame._renderTask?.cancel();
        frame._renderTask = null;
        // The cancelled task will never complete, so its key must not block a
        // fresh request for the same frame/key.
        delete frame.dataset.renderingKey;
        cancelQueuedRenders((entry) => entry.frame === frame);
      }

      function enqueueVisibleHighRenders(reason = "view") {
        const frames = visiblePageFrames();
        let priority = 5;
        frames.forEach((frame) => enqueueRender(frame, { quality: "high", priority: priority++, reason }));
      }

      async function waitForRequestId(requestId) {
        if (!requestId) return;
        const generation = state.generation;
        while (state.renderPromises.has(requestId)) {
          if (generation !== state.generation) return;
          await new Promise((resolve) => window.setTimeout(resolve, 50));
        }
      }

      function createObserver() {
        state.observer?.disconnect();
        state.observer = new IntersectionObserver((entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting);
          visible.forEach((entry) => {
            entry.target.dataset.near = "true";
            entry.target.dataset.visible = String(entry.intersectionRatio > 0);
            if (entry.target._cleanupTimer) {
              window.clearTimeout(entry.target._cleanupTimer);
              state.cleanupTimers.delete(entry.target._cleanupTimer);
              entry.target._cleanupTimer = null;
            }
            // Fast scrolling never starts new high renders — the existing bitmap
            // acts as the snapshot and new pages only get a low-res preview.
            enqueueRender(entry.target, {
              quality: state.isFastScrolling ? "preview" : "high",
              priority: state.isFastScrolling ? 10 : 20,
              reason: "observe",
            });
          });
          entries.filter((entry) => !entry.isIntersecting).forEach((entry) => {
            entry.target.dataset.near = "false";
            entry.target.dataset.visible = "false";
            scheduleOffscreenRelease(entry.target);
          });
        }, {
          root: elements.stage,
          rootMargin: "900px 0px",
          threshold: [0, 0.15, 0.5, 0.85],
        });
      }

      function settleAfterScroll() {
        state.scrollStopTimer = 0;
        state.smoothedScrollVelocity = 0;
        if (!state.isFastScrolling) return;
        state.isFastScrolling = false;
        elements.viewer.dataset.scrollState = "idle";
        // Recompute the real visible set (without the observer's rootMargin) and
        // rank by distance to the viewport centre: current page first, then the
        // remaining visible pages, then the next pages in the scroll direction.
        const frames = [...elements.pages.querySelectorAll("[data-page-number]")];
        const center = elements.stage.scrollTop + elements.stage.clientHeight / 2;
        const visible = frames
          .filter((frame) => frameIntersectsViewport(frame))
          .sort((a, b) => {
            const aDistance = Math.abs(a.offsetTop + a.offsetHeight / 2 - center);
            const bDistance = Math.abs(b.offsetTop + b.offsetHeight / 2 - center);
            return aDistance - bDistance;
          });
        const visiblePages = new Set(visible.map((frame) => Number(frame.dataset.pageNumber)));
        let priority = 10;
        visible.forEach((frame) => enqueueRender(frame, { quality: "high", priority: priority++, reason: "settle" }));
        const ahead = state.scrollDirection >= 0 ? 2 : 1;
        const behind = state.scrollDirection >= 0 ? 1 : 2;
        frames.forEach((frame) => {
          const number = Number(frame.dataset.pageNumber);
          if (visiblePages.has(number)) return;
          const offset = number - state.currentPage;
          if (offset > 0 && offset <= ahead) {
            enqueueRender(frame, { quality: "high", priority: 60, reason: "prefetch-ahead" });
          } else if (offset < 0 && -offset <= behind) {
            enqueueRender(frame, { quality: "high", priority: 60, reason: "prefetch-behind" });
          }
        });
      }

      function updateCurrentPageFromReadingLine() {
        const frame = chooseFrameAtReadingLine();
        if (!frame) return;
        const page = Number(frame.dataset.pageNumber);
        if (page !== state.currentPage) {
          state.currentPage = page;
          updateControls();
        }
      }

      function handleStageScroll() {
        if (!state.pdfDocument) return;
        const now = performance.now();
        const delta = elements.stage.scrollTop - state.lastScrollTop;
        const dt = Math.max(now - state.lastScrollTime, 1);
        const instantaneousVelocity = state.lastScrollTime === 0
          ? 0
          : Math.abs(delta) / dt;
        state.smoothedScrollVelocity = state.smoothedScrollVelocity * 0.65 + instantaneousVelocity * 0.35;
        state.scrollDirection = delta === 0 ? state.scrollDirection : Math.sign(delta);
        state.lastScrollTop = elements.stage.scrollTop;
        state.lastScrollTime = now;

        // Scrolling always cancels a pending tap; it never hides the chrome.
        cancelTapCandidate();

        if (state.mode !== "continuous") {
          // Paged mode has no document-length scroll; this only fires for the
          // in-page pan after zoom-in. Keep the anchor honest.
          scheduleProgressSave();
          return;
        }

        if (state.smoothedScrollVelocity >= FAST_SCROLL_ENTER_VELOCITY && !state.isFastScrolling) {
          state.isFastScrolling = true;
          elements.viewer.dataset.scrollState = "fast";
          // Drop queued (not yet started) high renders; the ones already running
          // stay, and pages that have left the real viewport are cancelled.
          cancelQueuedRenders((entry) => entry.quality === "high");
          framesInViewport().forEach((frame) => {
            if (!frameIntersectsViewport(frame)) {
              frame._renderTask?.cancel();
              frame._renderTask = null;
            }
          });
        }
        window.clearTimeout(state.scrollStopTimer);
        state.scrollStopTimer = window.setTimeout(settleAfterScroll, SCROLL_SETTLE_MS);
        updateCurrentPageFromReadingLine();
        scheduleProgressSave();
      }

      function framesInViewport() {
        return [...elements.pages.querySelectorAll("[data-page-number]")];
      }

      function visiblePageFrames() {
        if (state.mode !== "continuous") {
          return [...elements.pages.querySelectorAll("[data-page-number]")];
        }
        const margin = 900;
        const scrollTop = elements.stage.scrollTop;
        const viewportBottom = scrollTop + elements.stage.clientHeight;
        return [...elements.pages.querySelectorAll("[data-page-number]")].filter((frame) => {
          const top = frame.offsetTop;
          const bottom = top + frame.offsetHeight;
          return bottom > scrollTop - margin && top < viewportBottom + margin;
        });
      }

      // ---------- View builders ----------

      async function buildContinuousView({ anchor } = {}) {
        if (!state.pdfDocument) return false;
        cancelRenders();
        const generation = state.generation;
        elements.pages.replaceChildren();
        elements.pages.dataset.mode = "continuous";
        elements.stage.dataset.viewerMode = "continuous";
        const count = state.pdfDocument.numPages;
        for (let pageNumber = 1; pageNumber <= count; pageNumber += 1) {
          const dims = cssDimensionsForPage(pageNumber, 1);
          elements.pages.append(createPageFrame(pageNumber, dims));
        }
        if (generation !== state.generation) return false;

        // Give the target frame a viewport so the anchor can be restored before
        // the first render completes.
        const targetPage = anchor?.page ? clampPage(anchor.page) : 1;
        const targetFrame = frameForPage(targetPage);
        if (targetFrame) {
          const viewport = viewportForFrame(targetPage, displayScaleForPage(targetPage, 1));
          if (viewport) targetFrame._viewport = viewport;
        }

        state.lastScrollTop = elements.stage.scrollTop;
        state.lastScrollTime = 0;
        state.smoothedScrollVelocity = 0;
        restoreReadingAnchor(anchor);

        createObserver();
        [...elements.pages.children].forEach((frame) => state.observer.observe(frame));

        // The target page preview is the highest-priority request; near-page high
        // renders wait for it so the first revealed frame is never blank.
        const targetRequestId = enqueueRender(targetFrame, { quality: "preview", priority: 0, reason: "initial-restore" });
        await waitForRequestId(targetRequestId);
        if (generation !== state.generation) return false;

        enqueueVisibleHighRenders("view");
        updateControls();
        return generation === state.generation;
      }

      function createPagedLayer(page, mode) {
        const layer = document.createElement("div");
        layer.className = "lecture-viewer__paged-layer";
        const pagesInRow = mode === "spread" ? 2 : 1;
        const numbers = mode === "spread"
          ? [page, page + 1].filter((n) => n <= state.pdfDocument.numPages)
          : [page];
        numbers.forEach((pageNumber) => {
          const dims = cssDimensionsForPage(pageNumber, pagesInRow);
          layer.append(createPageFrame(pageNumber, dims));
        });
        return layer;
      }

      async function enqueuePagedLayerPreview(layer, { priority = 0, reason = "paged-preview" } = {}) {
        const requestIds = [...layer.querySelectorAll("[data-page-number]")].map((frame) =>
          enqueueRender(frame, { quality: "preview", priority, reason }),
        );
        // The preview concurrency is 1, so the two pages of a spread are rasterized
        // in reading order; the whole pair is revealed together.
        await Promise.all(requestIds.map((requestId) => waitForRequestId(requestId)));
      }

      function enqueuePagedLayerHigh(layer, reason = "paged-high") {
        [...layer.querySelectorAll("[data-page-number]")].forEach((frame, index) => {
          enqueueRender(frame, { quality: "high", priority: 10 + index, reason });
        });
      }

      function discardLayer(layer) {
        layer.remove();
      }

      async function buildPagedView({ page } = {}) {
        if (!state.pdfDocument) return false;
        cancelRenders();
        const generation = state.generation;
        elements.pages.replaceChildren();
        elements.pages.dataset.mode = state.mode;
        elements.stage.dataset.viewerMode = state.mode;
        const target = normalizePageForMode(page ?? state.currentPage, state.mode);
        const layer = createPagedLayer(target, state.mode);
        layer.classList.add("lecture-viewer__paged-layer--current");
        elements.pages.append(layer);
        await enqueuePagedLayerPreview(layer, { priority: 0 });
        if (generation !== state.generation) return false;
        enqueuePagedLayerHigh(layer);
        state.currentPage = target;
        updateControls();
        return generation === state.generation;
      }

      async function navigatePaged(direction, { immediate = false, reason = "gesture" } = {}) {
        if (state.isNavigating || state.isRestoring || state.mode === "continuous" || !state.pdfDocument) return;
        const serial = ++state.navigationSerial;
        const nextPage = normalizePageForMode(
          state.currentPage + direction * pageStep(state.mode),
          state.mode,
        );
        if (nextPage === state.currentPage) return;

        state.isNavigating = true;
        setNavigationState("preparing");
        const incoming = createPagedLayer(nextPage, state.mode);
        incoming.hidden = true;
        elements.pages.append(incoming);

        await enqueuePagedLayerPreview(incoming, { priority: 0, reason });
        if (serial !== state.navigationSerial) {
          discardLayer(incoming);
          state.isNavigating = false;
          setNavigationState("idle");
          return;
        }

        incoming.hidden = false;
        setNavigationState(immediate ? "idle" : "transitioning");
        await swapPagedLayers({ incoming, direction, immediate });
        if (serial !== state.navigationSerial) {
          state.isNavigating = false;
          setNavigationState("idle");
          return;
        }

        state.currentPage = nextPage;
        state.isNavigating = false;
        setNavigationState("idle");
        updateControls();
        scheduleProgressSave();
        enqueuePagedLayerHigh(incoming, reason);
        centerPagedLayer();
      }

      async function swapPagedLayers({ incoming, direction, immediate }) {
        const current = elements.pages.querySelector(".lecture-viewer__paged-layer--current");
        incoming.classList.add("lecture-viewer__paged-layer--current");
        incoming.classList.remove("lecture-viewer__paged-layer--incoming");
        if (!current) return;
        current.classList.add("lecture-viewer__paged-layer--incoming");
        current.classList.remove("lecture-viewer__paged-layer--current");
        const animate = !immediate
          && !prefersReducedMotion.matches
          && viewerElements.viewer.dataset.layoutState !== "restoring"
          && viewerElements.viewer.dataset.layoutState !== "relayout";
        if (animate) {
          const offset = direction >= 0 ? 18 : -18;
          incoming.style.transform = `translateX(${offset}px)`;
          incoming.style.opacity = "0";
          current.style.transform = "translateX(0)";
          current.style.opacity = "1";
          forceLayoutRead();
          incoming.style.transform = "translateX(0)";
          incoming.style.opacity = "1";
          current.style.transform = `translateX(${-offset}px)`;
          current.style.opacity = "0";
          await new Promise((resolve) => window.setTimeout(resolve, 170));
        }
        current.remove();
      }

      async function buildViewAtSavedPosition(saved) {
        if (state.mode === "continuous") {
          return buildContinuousView({ anchor: saved });
        }
        return buildPagedView({ page: normalizePageForMode(saved.page, state.mode) });
      }

      async function ensureTargetPreviewIsVisible() {
        const frame = frameForPage(state.currentPage);
        if (!frame) return;
        const canvas = frame.querySelector(".lecture-viewer__render-canvas");
        if (canvas && !canvas.hidden && canvas.width > 1) return;
        await waitForRequestId(enqueueRender(frame, { quality: "preview", priority: 0, reason: "initial-preview" }));
      }

      function applySavedReaderState(saved) {
        state.mode = saved.mode;
        state.zoom = saved.zoom;
        state.fit = saved.fit;
        state.currentPage = normalizePageForMode(saved.page, state.mode);
      }

      // ---------- Relayout & mode switching ----------

      function stageSizeChanged() {
        const stage = elements.stage;
        const width = stage.clientWidth;
        const height = stage.clientHeight;
        const changed = Math.abs(width - (state.lastStageWidth ?? -1)) >= 1
          || Math.abs(height - (state.lastStageHeight ?? -1)) >= 1;
        state.lastStageWidth = width;
        state.lastStageHeight = height;
        return changed;
      }

      // Refresh every frame's CSS size (and its PDF↔CSS viewport) from the current
      // metrics/zoom/fit, keeping the displayed bitmaps stretched as snapshots.
      function updateFrameCssDimensionsInPlace() {
        const pagesInRow = state.mode === "spread" ? 2 : 1;
        elements.pages.querySelectorAll("[data-page-number]").forEach((frame) => {
          const pageNumber = Number(frame.dataset.pageNumber);
          const dims = cssDimensionsForPage(pageNumber, pagesInRow);
          const surface = frame.querySelector(".lecture-viewer__page-surface");
          if (surface) {
            surface.style.width = `${dims.width}px`;
            surface.style.height = `${dims.height}px`;
          }
          const links = frame.querySelector(".lecture-viewer__link-layer");
          if (links) {
            links.style.width = `${dims.width}px`;
            links.style.height = `${dims.height}px`;
          }
          const shown = frame.querySelector(".lecture-viewer__render-canvas, .lecture-viewer__transition-canvas");
          if (shown && !shown.hidden && shown.width > 1) {
            shown.style.width = `${dims.width}px`;
            shown.style.height = `${dims.height}px`;
          }
          const viewport = viewportForFrame(pageNumber, displayScaleForPage(pageNumber, pagesInRow));
          if (viewport) frame._viewport = viewport;
        });
      }

      async function relayoutCurrentView({ reason = "layout", anchor = null } = {}) {
        if (!state.pdfDocument) return;
        // Keep the resize cache fresh for every caller; only outline-driven passes
        // skip work when the stage dimensions did not actually change.
        const sizeChanged = stageSizeChanged();
        if (reason === "outline-layout" && !sizeChanged) return;
        const request = ++state.layoutRequest;
        const captured = anchor ?? captureReadingAnchor() ?? state.lastStableAnchor;
        state.lastStableAnchor = captured;
        state.isRestoring = true;
        state.suppressProgressSave = true;
        setLayoutState("relayout");

        cancelRenders();
        updateFrameCssDimensionsInPlace();
        forceLayoutRead();
        if (state.mode === "continuous") {
          restoreContinuousAnchor(captured);
          state.lastScrollTop = elements.stage.scrollTop;
          state.lastScrollTime = 0;
          state.smoothedScrollVelocity = 0;
          if (request !== state.layoutRequest) return;
          createObserver();
          [...elements.pages.children].forEach((frame) => state.observer.observe(frame));
          enqueueVisibleHighRenders(reason);
        } else {
          centerPagedLayer();
          restorePagedAnchor(captured);
          if (request !== state.layoutRequest) return;
          [...elements.pages.querySelectorAll(".lecture-viewer__paged-layer--current [data-page-number]")].forEach((frame, index) => {
            enqueueRender(frame, { quality: "high", priority: 10 + index, reason });
          });
        }
        state.isRestoring = false;
        state.suppressProgressSave = false;
        setLayoutState("idle");
        scheduleProgressSave();
      }

      async function switchMode(nextMode) {
        if (nextMode === state.mode) return;
        cancelPendingWheelZoom();
        resetPagedWheelGesture();
        const anchor = captureReadingAnchor() ?? state.lastStableAnchor;
        state.lastStableAnchor = anchor;
        state.mode = nextMode;
        state.currentPage = normalizePageForMode(anchor?.page ?? state.currentPage, nextMode);
        state.isRestoring = true;
        state.suppressProgressSave = true;
        setLayoutState("restoring");
        try {
          if (nextMode === "continuous") {
            await buildContinuousView({ anchor });
            restoreReadingAnchor(anchor);
          } else {
            await buildPagedView({ page: state.currentPage });
            restorePagedAnchor(anchor);
          }
        } finally {
          state.isRestoring = false;
          state.suppressProgressSave = false;
          setLayoutState("idle");
        }
        updateControls();
        scheduleProgressSave();
      }

      // ---------- Navigation (outline / PDF links / named actions) ----------

      async function destinationArray(destination) {
        return typeof destination === "string"
          ? state.pdfDocument.getDestination(destination)
          : destination;
      }

      async function pageNumberForDestination(destination) {
        const resolved = await destinationArray(destination);
        if (!resolved?.[0]) return null;
        const pageIndex = Number.isInteger(resolved[0])
          ? resolved[0]
          : await state.pdfDocument.getPageIndex(resolved[0]);
        return { pageNumber: pageIndex + 1, resolved };
      }

      async function scrollToResolvedDestination(frame, resolved, behavior = "auto") {
        const type = resolved?.[1]?.name;
        const pdfTop = type === "XYZ" ? resolved[3]
          : (type === "FitH" || type === "FitBH") ? resolved[2]
          : type === "FitR" ? resolved[5]
          : null;
        let top = frame.offsetTop - 16;
        if (Number.isFinite(pdfTop) && frame._viewport) {
          const point = frame._viewport.convertToViewportPoint(0, pdfTop);
          top += point[1];
        }
        elements.stage.scrollTo({ top: Math.max(top, 0), behavior });
      }

      async function navigateToDestination(destination) {
        const target = await pageNumberForDestination(destination);
        if (!target) return;
        const page = clampPage(target.pageNumber);
        if (state.mode !== "continuous") {
          state.currentPage = normalizePageForMode(page, state.mode);
          await buildPagedView({ page: state.currentPage });
          updateControls();
          return;
        }
        state.currentPage = page;
        const frame = frameForPage(page);
        if (!frame) return;
        frame.dataset.near = "true";
        await waitForRequestId(enqueueRender(frame, { quality: "high", priority: 1, reason: "destination" }));
        const behavior = prefersReducedMotion.matches ? "auto" : "smooth";
        await scrollToResolvedDestination(frame, target.resolved, behavior);
        updateControls();
      }

      function runNamedAction(action) {
        const destinations = {
          FirstPage: 1,
          LastPage: state.pdfDocument.numPages,
          NextPage: state.currentPage + pageStep(state.mode),
          PrevPage: state.currentPage - pageStep(state.mode),
        };
        if (destinations[action]) goToPage(destinations[action]);
      }

      async function goToPage(page, { behavior = "auto", reason = "goto" } = {}) {
        const target = clampPage(page);
        if (state.mode === "continuous") {
          state.currentPage = target;
          const frame = frameForPage(target);
          if (frame) {
            frame.dataset.near = "true";
            await waitForRequestId(enqueueRender(frame, { quality: "high", priority: 1, reason }));
            elements.stage.scrollTo({ top: Math.max(frame.offsetTop - 16, 0), behavior });
          }
        } else {
          state.currentPage = normalizePageForMode(target, state.mode);
          await buildPagedView({ page: state.currentPage });
        }
        updateControls();
      }

      function buildOutline(items) {
        const list = document.createElement("ul");
        items.forEach((item) => {
          const entry = document.createElement("li");
          let control;
          if (item.url) {
            control = document.createElement("a");
            control.href = item.url;
            control.target = "_blank";
            control.rel = "noreferrer";
          } else if (item.dest) {
            control = document.createElement("button");
            control.type = "button";
            control.addEventListener("click", () => navigateToDestination(item.dest));
          } else {
            control = document.createElement("span");
          }
          control.textContent = item.title || "未命名章节";
          entry.append(control);
          if (item.items?.length) entry.append(buildOutline(item.items));
          list.append(entry);
        });
        return list;
      }

      async function renderOutline() {
        const outline = await state.pdfDocument.getOutline();
        elements.outlineList.replaceChildren();
        if (!outline?.length) {
          const empty = document.createElement("p");
          empty.className = "lecture-viewer__outline-empty";
          empty.textContent = "这份讲义没有可读取的目录。";
          elements.outlineList.append(empty);
          return;
        }
        elements.outlineList.append(buildOutline(outline));
      }

      // ---------- Layout scheduling ----------

      function scheduleLayoutRefresh(reason = "layout") {
        const request = ++state.layoutRequest;
        window.requestAnimationFrame(() => {
          if (request === state.layoutRequest) relayoutCurrentView({ reason });
        });
      }

      // window resize, visualViewport resize, fullscreen changes and the stage
      // ResizeObserver all funnel into this single 180ms debounced layout pass.
      function scheduleDebouncedLayoutRefresh() {
        window.clearTimeout(state.layoutTimer);
        state.layoutTimer = window.setTimeout(() => {
          state.layoutTimer = 0;
          // Re-check the effective DPR here as a belt-and-braces fallback: some
          // environments (headless CDP emulation, some driver setups) never fire
          // the resolution media query, while a real DPR change still shows up as
          // a layout-affecting resize.
          const dpr = readEffectiveDpr();
          let changed = stageSizeChanged();
          if (Math.abs(dpr - state.effectiveDpr) >= 0.01) {
            state.effectiveDpr = dpr;
            cancelRenders();
            changed = true;
          }
          if (changed) scheduleLayoutRefresh("resize");
        }, 180);
      }

      function handleWindowResize() {
        scheduleDebouncedLayoutRefresh();
      }

      function handleVisualViewportResize() {
        // Only a signal to re-check DPR/layout after environment changes; the
        // browser handles pinch-zoom compositing itself, so no extra multiplier.
        scheduleDebouncedLayoutRefresh();
      }

      // ---------- Zoom ----------

      // Synchronous half of a zoom: rescale every page (and its link layer) to
      // the new per-page CSS template and re-pin the focal point under the
      // cursor/centre. The old bitmaps stay visible while the fresh high render
      // is enqueued.
      function applyZoomStretch({ ratio, anchorPoint = null, generation }) {
        const stageRect = elements.stage.getBoundingClientRect();
        const focal = anchorPoint ?? {
          x: stageRect.left + elements.stage.clientWidth / 2,
          y: stageRect.top + elements.stage.clientHeight / 2,
        };
        const cursorX = focal.x - stageRect.left;
        const cursorY = focal.y - stageRect.top;
        const scrollLeftBefore = elements.stage.scrollLeft;
        const scrollTopBefore = elements.stage.scrollTop;
        const docXBefore = scrollLeftBefore + cursorX;
        const docYBefore = scrollTopBefore + cursorY;

        const frames = [...elements.pages.querySelectorAll("[data-page-number]")];

        // Locate the frame under the focal point; fall back to the current page.
        const anchorFrame = frames.find((frame) => {
          const top = frame.offsetTop;
          return docYBefore >= top && docYBefore < top + frame.offsetHeight;
        }) ?? frames.find((frame) => Number(frame.dataset.pageNumber) === state.currentPage);
        const anchorLocalX = anchorFrame ? Math.max(0, docXBefore - anchorFrame.offsetLeft) : 0;
        const anchorLocalY = anchorFrame ? Math.max(0, docYBefore - anchorFrame.offsetTop) : 0;

        const pagesInRow = state.mode === "spread" ? 2 : 1;
        frames.forEach((frame) => {
          const pageNumber = Number(frame.dataset.pageNumber);
          const dims = cssDimensionsForPage(pageNumber, pagesInRow);
          const surface = frame.querySelector(".lecture-viewer__page-surface");
          if (surface) {
            surface.style.width = `${dims.width}px`;
            surface.style.height = `${dims.height}px`;
          }
          const links = frame.querySelector(".lecture-viewer__link-layer");
          if (links) {
            links.style.width = `${dims.width}px`;
            links.style.height = `${dims.height}px`;
          }
          const shown = frame.querySelector(".lecture-viewer__render-canvas, .lecture-viewer__transition-canvas");
          if (shown && !shown.hidden && shown.width > 1) {
            shown.style.width = `${dims.width}px`;
            shown.style.height = `${dims.height}px`;
          }
          const viewport = viewportForFrame(pageNumber, displayScaleForPage(pageNumber, pagesInRow));
          if (viewport) frame._viewport = viewport;
        });

        // Force a synchronous reflow; continuous scrolls pin the focal point under
        // the cursor, paged modes keep the whole layer centred.
        if (state.mode === "continuous") {
          pinAnchor(anchorFrame, ratio, anchorLocalX, anchorLocalY, cursorX, cursorY, generation);
        } else {
          centerPagedLayer();
        }
      }

      function pinAnchor(anchorFrame, ratio, anchorLocalX, anchorLocalY, cursorX, cursorY, generation) {
        if (!anchorFrame || generation !== state.generation) return false;
        elements.stage.scrollLeft = Math.max(0, anchorFrame.offsetLeft + anchorLocalX * ratio - cursorX);
        elements.stage.scrollTop = Math.max(0, anchorFrame.offsetTop + anchorLocalY * ratio - cursorY);
        return true;
      }

      function applyZoomTransform({ previousZoom = 1, anchorPoint = null } = {}) {
        if (!state.pdfDocument) return null;
        // Supersede in-flight renders without discarding the shown bitmaps, so the
        // pages keep their old content (stretched) until the fresh render lands.
        state.generation += 1;
        const generation = state.generation;
        const ratio = state.zoom / previousZoom;
        applyZoomStretch({ ratio, anchorPoint, generation });
        const visible = new Set(visiblePageFrames());
        let priority = 30;
        [...visible].forEach((frame) => enqueueRender(frame, { quality: "high", priority: priority++, reason: "zoom" }));
        return { generation };
      }

      async function applyZoom({ previousZoom = 1, anchorPoint = null } = {}) {
        applyZoomTransform({ previousZoom, anchorPoint });
      }

      // Debounce rapid Ctrl+wheel input: each tick already stretched the shown
      // bitmaps and pinned the anchor synchronously, so the timer only needs to
      // submit the final high re-rasterization — no second stretch or re-pin.
      function scheduleWheelZoom(previousZoom, anchorPoint) {
        window.clearTimeout(state.pendingZoomTimer);
        state.pendingZoomTimer = window.setTimeout(() => {
          state.pendingZoomTimer = 0;
          state.generation += 1;
          const generation = state.generation;
          applyZoomStretch({ ratio: state.zoom / previousZoom, anchorPoint, generation });
          const visible = new Set(visiblePageFrames());
          let priority = 30;
          [...visible].forEach((frame) => enqueueRender(frame, { quality: "high", priority: priority++, reason: "zoom" }));
        }, 80);
      }

      // Cancel any pending debounced wheel zoom (e.g. a toolbar button zoom or a
      // mode/layout change arrived first) so a stale wheel sequence never fires.
      function cancelPendingWheelZoom() {
        if (state.pendingZoomTimer) {
          window.clearTimeout(state.pendingZoomTimer);
          state.pendingZoomTimer = 0;
        }
      }

      function handleWheelZoom(event) {
        event.preventDefault();
        const factor = event.deltaY < 0 ? 1.08 : 1 / 1.08;
        const nextZoom = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, Number((state.zoom * factor).toFixed(3))));
        if (nextZoom === state.zoom) return;
        const previousZoom = state.zoom;
        state.zoom = nextZoom;
        // Each wheel tick stretches the visible bitmaps to the new CSS size and
        // re-pins the focal point under the cursor synchronously, so the view
        // follows the wheel immediately. The high re-rasterization is merged into
        // one request that fires 80ms after the last wheel event.
        const stretchGeneration = ++state.generation;
        applyZoomStretch({
          ratio: state.zoom / previousZoom,
          anchorPoint: { x: event.clientX, y: event.clientY },
          generation: stretchGeneration,
        });
        scheduleWheelZoom(previousZoom, { x: event.clientX, y: event.clientY });
      }

      // ---------- Wheel paging (single/spread) ----------

      function normalizeWheelDelta(event) {
        const mode = event.deltaMode;
        let delta = event.deltaY;
        if (mode === WheelEvent.DOM_DELTA_LINE) delta *= 16;
        else if (mode === WheelEvent.DOM_DELTA_PAGE) delta *= elements.stage.clientHeight;
        if (Math.abs(delta) < 1) delta = event.deltaX;
        return delta;
      }

      function accumulatePagedWheel(delta) {
        const direction = Math.sign(delta);
        if (direction === 0) return;
        if (state.wheelDirection !== 0 && direction !== state.wheelDirection) {
          state.wheelAccumulator = 0; // a direction change clears the burst
        }
        state.wheelDirection = direction;
        state.wheelAccumulator += Math.abs(delta);
        if (!state.wheelLocked && state.wheelAccumulator >= WHEEL_PAGE_THRESHOLD) {
          state.wheelLocked = true;
          state.wheelAccumulator = 0;
          navigatePaged(direction > 0 ? 1 : -1, { reason: "wheel" });
        }
        // Each wheel event resets the settle timer; only a 220ms quiet gap clears
        // and unlocks the accumulator.
        window.clearTimeout(state.wheelUnlockTimer);
        state.wheelUnlockTimer = window.setTimeout(() => {
          state.wheelUnlockTimer = 0;
          state.wheelLocked = false;
          state.wheelAccumulator = 0;
          state.wheelDirection = 0;
        }, WHEEL_BURST_SETTLE_MS);
      }

      function handleStageWheel(event) {
        if (!state.pdfDocument) return;
        if (event.ctrlKey) return handleWheelZoom(event);
        if (state.mode === "continuous") return;
        if (state.isRestoring || state.isNavigating) {
          event.preventDefault();
          return;
        }
        event.preventDefault();
        const delta = normalizeWheelDelta(event);
        accumulatePagedWheel(delta);
      }

      // ---------- Pointer gestures (tap / swipe / fullscreen edge) ----------

      function beginFullscreenEdgeGesture(event) {
        if (!state.isFullscreen || !state.isMobileViewport) return false;
        if (!event.isPrimary || event.pointerType !== "touch") return false;
        const width = elements.stage.clientWidth;
        const stageRect = elements.stage.getBoundingClientRect();
        const localX = event.clientX - stageRect.left;
        const fromLeft = localX <= FULLSCREEN_EDGE_ZONE;
        const fromRight = localX >= width - FULLSCREEN_EDGE_ZONE;
        if (!fromLeft && !fromRight) return false;
        state.fullscreenEdgeGesture = {
          pointerId: event.pointerId,
          edge: fromLeft ? "left" : "right",
          startX: event.clientX,
          startY: event.clientY,
          startedAt: performance.now(),
        };
        state.gesture = null;
        state.tapCandidate = null;
        elements.stage.setPointerCapture?.(event.pointerId);
        return true;
      }

      function finishFullscreenEdgeGesture(event) {
        const gesture = state.fullscreenEdgeGesture;
        state.fullscreenEdgeGesture = null;
        if (!gesture || gesture.pointerId !== event.pointerId) return false;
        const dx = event.clientX - gesture.startX;
        const dy = event.clientY - gesture.startY;
        const inwardDistance = gesture.edge === "left" ? dx : -dx;
        const minDistance = Math.max(
          FULLSCREEN_EXIT_MIN_DISTANCE,
          elements.stage.clientWidth * FULLSCREEN_EXIT_WIDTH_RATIO,
        );
        const valid = inwardDistance >= minDistance
          && inwardDistance >= Math.abs(dy) * FULLSCREEN_EXIT_AXIS_RATIO
          && performance.now() - gesture.startedAt <= FULLSCREEN_EXIT_MAX_DURATION_MS;
        if (!valid || !isViewerFullscreen()) return false;
        state.pendingFullscreenAnchor = captureReadingAnchor();
        state.suppressTapUntil = performance.now() + 350;
        void document.exitFullscreen();
        return true;
      }

      function finishPointerGesture(event) {
        const gesture = state.gesture;
        state.gesture = null;
        if (!gesture || gesture.pointerId !== event.pointerId || gesture.fired) return false;
        if (state.mode === "continuous" || state.isFullscreen) return false;
        if (state.isRestoring || state.isNavigating) return false;
        if (document.hidden) return false;
        const dx = (gesture.lastX ?? event.clientX) - gesture.x;
        const dy = (gesture.lastY ?? event.clientY) - gesture.y;
        const elapsed = performance.now() - gesture.startedAt;
        const minDistance = Math.max(SWIPE_MIN_DISTANCE, elements.stage.clientWidth * SWIPE_WIDTH_RATIO);
        const horizontal = Math.abs(dx) >= minDistance;
        const axisClear = Math.abs(dx) >= Math.abs(dy) * SWIPE_AXIS_RATIO;
        const timely = elapsed <= SWIPE_MAX_DURATION_MS;
        if (!horizontal || !axisClear || !timely) return false;
        gesture.fired = true;
        navigatePaged(dx < 0 ? 1 : -1, { reason: "swipe" });
        return true;
      }

      function finishTapCandidate(event) {
        const candidate = state.tapCandidate;
        state.tapCandidate = null;
        if (!candidate || candidate.pointerId !== event.pointerId) return false;
        if (candidate.blocked || candidate.moved) return false;
        if (performance.now() - candidate.startedAt > TAP_MAX_DURATION_MS) return false;
        if (performance.now() < state.suppressTapUntil) return false;
        if (state.isFullscreen) return false;
        if (state.isNavigating || state.isRestoring) return false;
        if (state.pendingZoomTimer !== 0) return false;
        if (elements.body.dataset.outlineOpen === "true") return false;
        setChromeVisible(!state.chromeVisible, { reason: "tap" });
        return true;
      }

      function handleStagePointerDown(event) {
        state.activePointers.add(event.pointerId);
        if (state.activePointers.size > 1) {
          cancelTapCandidate();
          cancelPointerGesture();
        }
        if (beginFullscreenEdgeGesture(event)) return;
        if (event.pointerType !== "touch" || !event.isPrimary) return;
        const interactive = isInteractivePath(event.composedPath());
        if (interactive) return;
        state.tapCandidate = {
          pointerId: event.pointerId,
          x: event.clientX,
          y: event.clientY,
          startedAt: performance.now(),
          moved: false,
          blocked: false,
        };
        if (state.mode === "single" || state.mode === "spread") {
          state.gesture = {
            pointerId: event.pointerId,
            x: event.clientX,
            y: event.clientY,
            startedAt: performance.now(),
            fired: false,
          };
        }
      }

      function handleStagePointerMove(event) {
        const candidate = state.tapCandidate;
        if (candidate && candidate.pointerId === event.pointerId && !candidate.moved) {
          if (Math.hypot(event.clientX - candidate.x, event.clientY - candidate.y) > TAP_MOVE_TOLERANCE) {
            candidate.moved = true;
          }
        }
        const gesture = state.gesture;
        if (gesture && gesture.pointerId === event.pointerId && !gesture.fired) {
          gesture.lastX = event.clientX;
          gesture.lastY = event.clientY;
        }
      }

      function handleStagePointerUp(event) {
        state.activePointers.delete(event.pointerId);
        if (finishFullscreenEdgeGesture(event)) {
          cancelTapCandidate();
          cancelPointerGesture();
          return;
        }
        if (finishPointerGesture(event)) {
          state.suppressTapUntil = performance.now() + 300;
          cancelTapCandidate();
          return;
        }
        finishTapCandidate(event);
      }

      function handleStagePointerCancel(event) {
        state.activePointers.delete(event.pointerId);
        cancelTapCandidate();
        cancelPointerGesture();
        if (state.fullscreenEdgeGesture?.pointerId === event.pointerId) {
          state.fullscreenEdgeGesture = null;
        }
      }

      // ---------- Fullscreen ----------

      function isViewerFullscreen() {
        return document.fullscreenElement === viewerElements?.viewer;
      }

      function closeReaderFloatingUi() {
        const musicPlayer = elements.viewer.querySelector("[data-music-player]");
        musicPlayer?.dispatchEvent(new CustomEvent("rongyu:music-close-panel"));
      }

      function handleFullscreenEscapeCapture(event) {
        if (event.key === "Escape" && isViewerFullscreen()) {
          state.pendingFullscreenAnchor = captureReadingAnchor();
        }
      }

      async function handleFullscreenChange() {
        const active = isViewerFullscreen();
        state.isFullscreen = active;
        elements.viewer.dataset.fullscreen = String(active);
        elements.fullscreen.setAttribute("aria-pressed", String(active));
        closeOutline({ restoreFocus: false });
        cancelTapCandidate();
        cancelPointerGesture();
        resetPagedWheelGesture();
        if (active) {
          closeReaderFloatingUi();
          setChromeVisible(false, { reason: "fullscreen" });
        } else {
          // Both computer and phone restore the full toolbar after fullscreen so
          // the core controls are immediately reachable.
          setChromeVisible(true, { reason: "fullscreen-exit" });
        }
        document.dispatchEvent(new CustomEvent("reader-fullscreen-change", { detail: { active } }));
        window.clearTimeout(state.layoutTimer);
        await relayoutCurrentView({
          reason: active ? "fullscreen-enter" : "fullscreen-exit",
          anchor: state.pendingFullscreenAnchor ?? state.lastStableAnchor,
        });
        state.pendingFullscreenAnchor = null;
      }

      // ---------- Persistence / document listeners ----------

      function handleVisibilityChange() {
        if (document.visibilityState === "hidden") flushProgressSave();
      }

      function handlePageHide() {
        flushProgressSave();
      }

      function handleDocumentKeydown(event) {
        if (event.key !== "Escape") return;
        if (state.isFullscreen) return; // the browser owns fullscreen Escape
        if (elements.body.dataset.outlineOpen === "true") {
          closeOutline({ restoreFocus: true });
          return;
        }
        if (state.isMobileViewport && !state.chromeVisible) {
          setChromeVisible(true, { reason: "escape" });
        }
      }

      // ---------- Outline ----------

      function closeOutline({ restoreFocus = true } = {}) {
        const wasOpen = elements.body.dataset.outlineOpen === "true";
        elements.body.dataset.outlineOpen = "false";
        elements.outline.hidden = true;
        elements.outlineScrim.hidden = true;
        elements.outlineToggle.setAttribute("aria-expanded", "false");
        elements.stage.removeAttribute("inert");
        if (restoreFocus) elements.outlineToggle.focus({ preventScroll: true });
        if (wasOpen) scheduleLayoutRefresh("outline-layout");
      }

      function openOutline() {
        if (state.isFullscreen) return;
        setChromeVisible(true, { reason: "outline" });
        elements.body.dataset.outlineOpen = "true";
        elements.outline.hidden = false;
        elements.outlineScrim.hidden = !state.isMobileViewport;
        elements.outlineToggle.setAttribute("aria-expanded", "true");
        if (state.isMobileViewport) elements.stage.setAttribute("inert", "");
        scheduleLayoutRefresh("outline-layout");
      }

      // ---------- DPR watching ----------

      function watchDprChanges() {
        state.effectiveDpr = readEffectiveDpr();
        const previousHandler = state.dprChangeHandler;
        state.dprMediaQuery?.removeEventListener("change", previousHandler);
        state.dprChangeHandler = () => {
          // The media query only matches the DPR it was created for; rebuild it
          // against the new value so future changes are still observed.
          const previousDpr = state.effectiveDpr;
          watchDprChanges();
          const nextDpr = state.effectiveDpr;
          // A real pixel-density change supersedes stale renders and, once the
          // layout settles, re-renders the visible pages at the new DPR. A
          // difference below 0.01 is only a layout change — the debounce handles it.
          if (Math.abs(nextDpr - previousDpr) >= 0.01) {
            cancelRenders();
          }
          scheduleDebouncedLayoutRefresh();
        };
        state.dprMediaQuery = window.matchMedia(`(resolution: ${state.effectiveDpr}dppx)`);
        state.dprMediaQuery.addEventListener("change", state.dprChangeHandler);
        // Some environments (headless CDP emulation, some driver setups) never
        // fire the resolution media query; a 1s polling loop keeps effectiveDpr
        // honest even there. It only acts when the value actually changed.
        window.clearInterval(state.dprPollTimer);
        state.dprPollTimer = window.setInterval(() => {
          const dpr = readEffectiveDpr();
          if (Math.abs(dpr - state.effectiveDpr) >= 0.01) {
            state.effectiveDpr = dpr;
            cancelRenders();
            scheduleDebouncedLayoutRefresh();
          }
        }, 1000);
      }

      // ---------- Event wiring ----------

      elements.outlineToggle.addEventListener("click", () => {
        if (state.isFullscreen) return;
        if (elements.body.dataset.outlineOpen === "true") closeOutline();
        else openOutline();
      });
      elements.outlineClose.addEventListener("click", () => closeOutline({ restoreFocus: true }));
      elements.outlineScrim.addEventListener("click", () => closeOutline({ restoreFocus: true }));
      elements.chromeShow.addEventListener("click", () => setChromeVisible(true, { reason: "safety" }));
      elements.modeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          switchMode(button.dataset.viewerMode).catch((error) => console.error("mode switch failed", error));
        });
      });
      elements.zoomOut.addEventListener("click", async () => {
        cancelPendingWheelZoom();
        const previousZoom = state.zoom;
        state.zoom = Math.max(MIN_ZOOM, Number((state.zoom / 1.12).toFixed(3)));
        await applyZoom({ previousZoom });
      });
      elements.zoomIn.addEventListener("click", async () => {
        cancelPendingWheelZoom();
        const previousZoom = state.zoom;
        state.zoom = Math.min(MAX_ZOOM, Number((state.zoom * 1.12).toFixed(3)));
        await applyZoom({ previousZoom });
      });
      elements.fitWidth.addEventListener("click", async () => {
        cancelPendingWheelZoom();
        state.fit = "width";
        state.zoom = 1;
        await relayoutCurrentView({ reason: "fit-width" });
      });
      elements.fitHeight.addEventListener("click", async () => {
        cancelPendingWheelZoom();
        state.fit = "height";
        state.zoom = 1;
        await relayoutCurrentView({ reason: "fit-height" });
      });
      elements.fullscreen.addEventListener("click", async () => {
        state.pendingFullscreenAnchor = captureReadingAnchor();
        try {
          if (isViewerFullscreen()) await document.exitFullscreen();
          else await elements.viewer.requestFullscreen();
        } catch {
          state.pendingFullscreenAnchor = null;
          elements.fullscreen.setAttribute("aria-pressed", "false");
          setChromeVisible(true, { reason: "fullscreen-error" });
        }
      });
      document.addEventListener("fullscreenchange", handleFullscreenChange);
      document.addEventListener("visibilitychange", handleVisibilityChange);
      document.addEventListener("keydown", handleDocumentKeydown);
      document.addEventListener("keydown", handleFullscreenEscapeCapture, true);
      window.addEventListener("resize", handleWindowResize);
      window.addEventListener("pagehide", handlePageHide);
      window.visualViewport?.addEventListener("resize", handleVisualViewportResize);
      elements.stage.addEventListener("scroll", handleStageScroll, { passive: true });
      elements.stage.addEventListener("wheel", handleStageWheel, { passive: false });
      elements.stage.addEventListener("pointerdown", handleStagePointerDown);
      elements.stage.addEventListener("pointermove", handleStagePointerMove);
      elements.stage.addEventListener("pointerup", handleStagePointerUp);
      elements.stage.addEventListener("pointercancel", handleStagePointerCancel);
      state.eventHandlers = {
        onWindowResize: handleWindowResize,
        onVisualViewportResize: handleVisualViewportResize,
        onFullscreenChange: handleFullscreenChange,
        onVisibilityChange: handleVisibilityChange,
        onPageHide: handlePageHide,
        onDocumentKeydown: handleDocumentKeydown,
        onFullscreenEscapeCapture: handleFullscreenEscapeCapture,
        onStageScroll: handleStageScroll,
        onStageWheel: handleStageWheel,
        onStagePointerDown: handleStagePointerDown,
        onStagePointerMove: handleStagePointerMove,
        onStagePointerUp: handleStagePointerUp,
        onStagePointerCancel: handleStagePointerCancel,
      };

      state.stageResizeObserver = new ResizeObserver(() => {
        // Layout refresh follows the stage's real content rect; the window resize
        // handler stays as a compatibility fallback. Both share the 180ms debounce.
        scheduleDebouncedLayoutRefresh();
      });
      state.stageResizeObserver.observe(elements.stage);
      state.effectiveDpr = readEffectiveDpr();
      watchDprChanges();

      try {
        state.documentTask = pdfjs.getDocument({ url: pdfUrl, isEvalSupported: false });
        state.pdfDocument = await state.documentTask.promise;
        const saved = loadProgressV2OrMigrateV1();
        applySavedReaderState(saved);
        const loaded = await loadPageMetrics(state.pdfDocument);
        state.pageMetrics = loaded.metrics;
        state.pageProxies = loaded.proxies;

        setLayoutState("restoring");
        state.suppressProgressSave = true;
        await Promise.all([
          renderOutline(),
          buildViewAtSavedPosition(saved),
        ]);
        await ensureTargetPreviewIsVisible();
        restoreReadingAnchor(saved);
        await nextAnimationFrame();

        elements.message.hidden = true;
        state.suppressProgressSave = false;
        setLayoutState("idle");
        updateControls();
        scheduleProgressSave();
      } catch (error) {
        console.error("Unable to load lecture", error);
        showError("讲义暂时无法载入，请返回目录后重试。");
      }
    }

    document.addEventListener("astro:page-load", initialiseViewer);
    document.addEventListener("astro:before-swap", destroyDocument);
  })();
</script>
