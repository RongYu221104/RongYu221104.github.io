---
import {
  ArrowLeft,
  ChevronLeft,
  ChevronRight,
  Download,
  ZoomIn,
  ZoomOut,
} from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="讲义阅读"
  description="RongYu's Notes 讲义阅读器。"
  pageClass="viewer-page"
  hideFooter={true}
>
  <section class="lecture-viewer" aria-labelledby="viewer-title">
    <header class="lecture-viewer__toolbar">
      <a class="lecture-viewer__back" href="/latex/" aria-label="返回讲义目录" title="返回讲义目录">
        <ArrowLeft size={18} strokeWidth={1.7} />
        <span>讲义目录</span>
      </a>

      <div class="lecture-viewer__identity">
        <p>RongYu's Reader</p>
        <h1 id="viewer-title">正在准备讲义</h1>
      </div>

      <a
        class="lecture-viewer__download"
        href="/latex/"
        download
        aria-label="下载讲义"
        title="下载讲义"
        data-viewer-download
      >
        <Download size={18} strokeWidth={1.7} />
        <span>下载</span>
      </a>
    </header>

    <div class="lecture-viewer__reader">
      <div class="lecture-viewer__stage" data-viewer-stage aria-live="polite">
        <div class="lecture-viewer__message" data-viewer-message>
          <span class="lecture-viewer__loading-mark" aria-hidden="true"></span>
          <p>正在载入讲义</p>
        </div>
        <canvas data-viewer-canvas hidden></canvas>
      </div>

      <div class="lecture-viewer__controls" aria-label="阅读控制">
        <button type="button" data-viewer-previous aria-label="上一页" title="上一页" disabled>
          <ChevronLeft size={20} strokeWidth={1.7} />
        </button>
        <div class="lecture-viewer__page-status" aria-live="polite">
          <span data-viewer-page>--</span>
          <span>/</span>
          <span data-viewer-total>--</span>
        </div>
        <button type="button" data-viewer-next aria-label="下一页" title="下一页" disabled>
          <ChevronRight size={20} strokeWidth={1.7} />
        </button>
        <span class="lecture-viewer__control-divider" aria-hidden="true"></span>
        <button type="button" data-viewer-zoom-out aria-label="缩小" title="缩小" disabled>
          <ZoomOut size={18} strokeWidth={1.7} />
        </button>
        <button type="button" data-viewer-zoom-in aria-label="放大" title="放大" disabled>
          <ZoomIn size={18} strokeWidth={1.7} />
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script is:inline>
  (() => {
    const allowedLecturePath = /^\/lectures\/(maths|physics)\/[^/]+\.pdf$/;
    let activeRender = null;
    let documentTask = null;
    let pdfDocument = null;
    let currentPage = 1;
    let zoom = 1;
    let resizeTimer = 0;

    async function destroyDocument() {
      activeRender?.cancel();
      activeRender = null;
      await pdfDocument?.destroy();
      pdfDocument = null;
      await documentTask?.destroy();
      documentTask = null;
    }

    async function initialiseViewer() {
      await destroyDocument();

      const stage = document.querySelector("[data-viewer-stage]");
      const canvas = document.querySelector("[data-viewer-canvas]");
      const message = document.querySelector("[data-viewer-message]");
      const title = document.querySelector("#viewer-title");
      const download = document.querySelector("[data-viewer-download]");
      const pageNumber = document.querySelector("[data-viewer-page]");
      const totalPages = document.querySelector("[data-viewer-total]");
      const previous = document.querySelector("[data-viewer-previous]");
      const next = document.querySelector("[data-viewer-next]");
      const zoomOut = document.querySelector("[data-viewer-zoom-out]");
      const zoomIn = document.querySelector("[data-viewer-zoom-in]");

      if (!stage || !canvas || !message || !title || !download || !pageNumber || !totalPages || !previous || !next || !zoomOut || !zoomIn) return;

      const params = new URLSearchParams(window.location.search);
      const requestedFile = params.get("file");
      const requestedTitle = params.get("title") || "讲义阅读";
      let pdfUrl;

      try {
        const candidate = new URL(requestedFile || "", window.location.origin);
        if (candidate.origin !== window.location.origin || !allowedLecturePath.test(candidate.pathname)) {
          throw new Error("请从讲义目录选择需要阅读的讲义。");
        }
        pdfUrl = `${candidate.pathname}${candidate.search}`;
      } catch (error) {
        title.textContent = "无法打开讲义";
        message.innerHTML = '<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 8v5m0 4h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg><p></p>';
        message.querySelector("p").textContent = error.message || "讲义链接无效。";
        return;
      }

      title.textContent = requestedTitle;
      document.title = `${requestedTitle} | RongYu's Notes`;
      download.href = pdfUrl;
      download.download = decodeURIComponent(pdfUrl.split("/").pop() || "lecture.pdf");

      const pdfjs = window.pdfjsLib;
      if (!pdfjs?.getDocument) {
        message.textContent = "阅读器资源未能载入，请刷新页面后重试。";
        return;
      }

      pdfjs.GlobalWorkerOptions.workerSrc = "https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js";
      currentPage = 1;
      zoom = 1;

      const updateControls = () => {
        const hasDocument = Boolean(pdfDocument);
        previous.disabled = !hasDocument || currentPage <= 1;
        next.disabled = !hasDocument || currentPage >= pdfDocument.numPages;
        zoomOut.disabled = !hasDocument || zoom <= 0.7;
        zoomIn.disabled = !hasDocument || zoom >= 1.7;
        pageNumber.textContent = hasDocument ? String(currentPage) : "--";
        totalPages.textContent = hasDocument ? String(pdfDocument.numPages) : "--";
      };

      const renderPage = async () => {
        if (!pdfDocument) return;
        activeRender?.cancel();
        const page = await pdfDocument.getPage(currentPage);
        const baseViewport = page.getViewport({ scale: 1 });
        const availableWidth = Math.min(stage.clientWidth - 36, 1120);
        const displayScale = Math.max(0.25, (availableWidth / baseViewport.width) * zoom);
        const pixelScale = Math.min(window.devicePixelRatio || 1, 2);
        const viewport = page.getViewport({ scale: displayScale * pixelScale });
        const context = canvas.getContext("2d", { alpha: false });

        if (!context) throw new Error("浏览器不支持画布渲染。");

        canvas.width = Math.ceil(viewport.width);
        canvas.height = Math.ceil(viewport.height);
        canvas.style.width = `${Math.ceil(viewport.width / pixelScale)}px`;
        canvas.style.height = `${Math.ceil(viewport.height / pixelScale)}px`;
        canvas.hidden = false;
        message.hidden = true;
        activeRender = page.render({ canvasContext: context, viewport });

        try {
          await activeRender.promise;
        } catch (error) {
          if (error?.name !== "RenderingCancelledException") throw error;
        }

        updateControls();
      };

      previous.addEventListener("click", () => {
        if (currentPage > 1) {
          currentPage -= 1;
          renderPage();
        }
      });
      next.addEventListener("click", () => {
        if (pdfDocument && currentPage < pdfDocument.numPages) {
          currentPage += 1;
          renderPage();
        }
      });
      zoomOut.addEventListener("click", () => {
        zoom = Math.max(0.7, Number((zoom - 0.15).toFixed(2)));
        renderPage();
      });
      zoomIn.addEventListener("click", () => {
        zoom = Math.min(1.7, Number((zoom + 0.15).toFixed(2)));
        renderPage();
      });
      window.addEventListener("resize", () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(renderPage, 160);
      }, { once: true });

      try {
        documentTask = pdfjs.getDocument({
          url: pdfUrl,
          disableFontFace: true,
          isEvalSupported: false,
        });
        pdfDocument = await documentTask.promise;
        await renderPage();
      } catch (error) {
        console.error("Unable to load lecture", error);
        title.textContent = "无法打开讲义";
        message.hidden = false;
        message.innerHTML = '<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 8v5m0 4h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg><p>讲义暂时无法载入，请返回目录后重试。</p>';
      }
    }

    document.addEventListener("astro:page-load", initialiseViewer);
  })();
</script>
