---
import { ArrowUpRight, Download } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tools } from "../../data/tools";
---

<BaseLayout
  title="工具"
  description="容与制作与收集的规划、文档和日常效率工具。"
  pageClass="tools-page"
>
  <header class="page-intro section-shell">
    <p class="page-intro__kicker">Tools · personal utilities</p>
    <h1>工具</h1>
    <p>规划、文档与日常效率工具，安静地各司其职。</p>
  </header>

  <section class="tools-catalog section-shell" aria-label="工具目录">
    {tools.map((tool, index) => (
      <article class="tool-entry" id={tool.slug}>
        <header class="tool-entry__heading">
          <div>
            <p class="tool-entry__index">
              Tool {String(index + 1).padStart(2, "0")} · {tool.category}
            </p>
            <h2 id={`${tool.slug}-title`}>{tool.name}</h2>
          </div>
          <div class="tool-entry__actions">
            {tool.openPath && (
              <a class="text-command" href={tool.openPath}>
                打开 {tool.name}
                <ArrowUpRight size={18} strokeWidth={1.6} />
              </a>
            )}
            <a
              class="text-command"
              href={tool.downloadPath}
              download={tool.downloadFilename}
            >
              下载 {tool.name}
              <Download size={17} strokeWidth={1.6} />
            </a>
          </div>
        </header>

        {tool.openPath ? (
          <a
            class="tool-entry__preview"
            href={tool.openPath}
            aria-label={`打开 ${tool.name}`}
          >
            <span class="tool-entry__preview-bar">
              <span>{tool.name}</span>
              <span>Browser utility</span>
            </span>
            <img
              src={tool.preview}
              width="2560"
              height="1440"
              alt={tool.previewAlt}
              loading="eager"
              decoding="async"
            />
          </a>
        ) : (
          <div class="tool-entry__preview">
            <span class="tool-entry__preview-bar">
              <span>{tool.name}</span>
              <span>Offline utility</span>
            </span>
            <img
              src={tool.preview}
              width="2560"
              height="1440"
              alt={tool.previewAlt}
              loading="eager"
              decoding="async"
            />
          </div>
        )}

        <div class="tool-entry__details">
          <p class="tool-entry__subtitle">{tool.subtitle}</p>
          <p>{tool.description}</p>
          <p class="tool-entry__meta">{tool.meta}</p>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
