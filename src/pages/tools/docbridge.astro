---
import { ArrowLeft, ExternalLink } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="DocBridge"
  description="在浏览器中完成 PDF、SVG 与 PPTX 文档转换。"
  pageClass="tool-app-page"
  hideFooter
>
  <section class="app-toolbar">
    <a href="/tools/">
      <ArrowLeft size={17} strokeWidth={1.7} />
      返回工具
    </a>
    <div>
      <strong>DocBridge</strong>
      <span>文档转换与处理工具</span>
    </div>
    <a
      href="/apps/docbridge/index.html"
      target="_blank"
      rel="noreferrer"
      title="在新窗口打开"
    >
      <ExternalLink size={17} strokeWidth={1.7} />
      <span>新窗口</span>
    </a>
  </section>
  <iframe
    class="tool-app-frame"
    src="/apps/docbridge/index.html"
    title="DocBridge 文档转换与处理工具"
  ></iframe>
</BaseLayout>
